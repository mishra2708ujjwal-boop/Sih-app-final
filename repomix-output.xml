      rssi: rssi ?? this.rssi,
      isLocalProcessing: isLocalProcessing ?? this.isLocalProcessing,
      isHeartRateActive: isHeartRateActive ?? this.isHeartRateActive,
      isSpo2Active: isSpo2Active ?? this.isSpo2Active,
