import '../../shared/widgets/empty_state.dart';
import '../../shared/widgets/fade_slide_in.dart';
import '../../shared/widgets/status_pill.dart';
import '../../shared/widgets/info_row.dart';

/// Sleep & recovery body — embedded as the "Sleep" segment of Vitals.
///
/// No `Scaffold` of its own: the parent Vitals screen owns the header and the
/// segmented control.
///
/// The old Day/Week/Month switcher is gone. It set state but rendered identical
/// last-night data for all three periods, and `SleepReading` carries no
/// week/month history to render — one honest view beats three that lie.
class SleepView extends StatelessWidget {
  const SleepView({super.key});

  @override
  Widget build(BuildContext context) {
    final controller = context.watch<PranaHealthController>();
    final sleep = controller.currentSleep;
    final baseline = controller.currentBaseline;

    const padding = EdgeInsets.fromLTRB(
      AppSpacing.md,
      AppSpacing.xxs,
      AppSpacing.md,
      AppSpacing.navClearance,
    );

    // Nothing recorded — don't draw an empty hypnogram and a 0h 0m hero.
    if (sleep.totalDurationMinutes <= 0) {
      return SingleChildScrollView(
        padding: padding,
        child: AppCard(
          child: EmptyState(
            icon: Icons.bedtime_outlined,
            iconColor: AppColors.sleep,
            title: 'No sleep recorded yet',
            subtitle:
                'Wear your PRANA band overnight and last night’s sleep will '
                'show up here.',
            actionLabel: 'Connect device',
            onAction: () => controller.startBleScan(),
          ),
        ),
      );
    }

    final hours = sleep.totalDurationMinutes ~/ 60;
    final minutes = sleep.totalDurationMinutes % 60;
    var order = 0;

    return SingleChildScrollView(
      padding: padding,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // ── Duration hero ────────────────────────────────────────────────
          FadeSlideIn(
            index: order++,
            child: AppCard(
              elevated: true,
              padding: const EdgeInsets.all(AppSpacing.lg),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      Expanded(
                        child: Text(
                          'Last night',
                          style: AppTypography.labelMedium.copyWith(
                            color: AppColors.sleep,
                            fontWeight: FontWeight.w700,
                          ),
                        ),
                      ),
                      StatusPill(
                        label:
                            'Quality ${sleep.sleepQualityScore.toStringAsFixed(0)}/100',
                        color: AppColors.sleep,
                        backgroundColor: AppColors.sleepBg,
                      ),
                    ],
                  ),
                  AppSpacing.gapSm,
                  Row(
                    crossAxisAlignment: CrossAxisAlignment.baseline,
                    textBaseline: TextBaseline.alphabetic,
                    children: [
                      Text(
                        '${hours}h ${minutes}m',
                        style: AppTypography.displayMedium.copyWith(
                          color: AppColors.sleep,
                        ),
                      ),
                      AppSpacing.hGapXs,
                      Expanded(
                        child: Text(
                          'of an 8h goal',
                          style: AppTypography.bodySmall,
                        ),
                      ),
                    ],
                  ),
                  AppSpacing.gapSm,
                  ClipRRect(
                    borderRadius: AppRadius.brPill,
                    child: LinearProgressIndicator(
                      value: (sleep.totalDurationMinutes / 480.0).clamp(0.0, 1.0),
                      backgroundColor: AppColors.borderLight,
                      valueColor:
                          const AlwaysStoppedAnimation<Color>(AppColors.sleep),
                      minHeight: 8,
                    ),
                  ),
                ],
              ),
            ),
          ),
          AppSpacing.gapSm,

          // ── Hypnogram ────────────────────────────────────────────────────
          FadeSlideIn(
            index: order++,
            child: HypnogramChart(stages: sleep.hypnogramStages),
          ),

          // ── Stage breakdown (2x2 — four across gave each box ~54dp) ──────
          FadeSlideIn(
            index: order++,
            child: const SectionHeader(title: 'Sleep stages'),
          ),
          FadeSlideIn(
            index: order++,
            child: LayoutBuilder(
              builder: (context, constraints) {
                final cellWidth = (constraints.maxWidth - AppSpacing.sm) / 2;
                final scale = MediaQuery.textScalerOf(context).scale(1);
                final cellHeight =
                    (cellWidth / 2.3) * (scale > 1 ? scale * 0.96 : 1);

                return GridView.count(
                  crossAxisCount: 2,
                  crossAxisSpacing: AppSpacing.sm,
                  mainAxisSpacing: AppSpacing.sm,
                  childAspectRatio: cellWidth / cellHeight,
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  children: [
                    _StageTile(
                      title: 'Deep sleep',
                      duration: '${sleep.deepSleepMinutes}m',
                      note: 'Physical recovery',
                      color: const Color(0xFF1E3A8A),
                    ),
                    _StageTile(
                      title: 'REM sleep',
                      duration: '${sleep.remSleepMinutes}m',
                      note: 'Memory and mood',
                      color: const Color(0xFF8B5CF6),
                    ),
                    _StageTile(
                      title: 'Light sleep',
                      duration: '${sleep.lightSleepMinutes}m',
                      note: 'Most of the night',
                      color: const Color(0xFF60A5FA),
                    ),
                    _StageTile(
                      title: 'Awake',
                      duration: '${sleep.awakeMinutes}m',
                      note: 'Time spent awake',
                      color: const Color(0xFFEF4444),
                    ),
                  ],
                );
              },
            ),
          ),

          // ── Recovery ─────────────────────────────────────────────────────
          FadeSlideIn(
            index: order++,
            child: const SectionHeader(title: 'Recovery'),
          ),
          FadeSlideIn(
            index: order++,
            child: AppCard(
              padding: const EdgeInsets.symmetric(horizontal: AppSpacing.md),
              child: Column(
                children: [
                  InfoRow(
                    icon: Icons.favorite_rounded,
                    title: 'Resting heart rate',
                    subtitle:
                        'Your baseline is ${baseline.restingHrBaseline.toStringAsFixed(0)} BPM',
                    value: '${sleep.restingHeartRate.toStringAsFixed(0)} BPM',
                    iconColor: AppColors.heartRate,
                  ),
                  const Divider(height: 1),
                  InfoRow(
                    icon: Icons.air_rounded,
                    title: 'Breathing rate',
                    subtitle: 'Normal is 12–20 breaths a minute',
                    value: '${sleep.respiratoryRate} rpm',
                    iconColor: AppColors.spo2,
                  ),
                  const Divider(height: 1),
                  InfoRow(
                    icon: Icons.battery_charging_full_rounded,
                    title: 'Recovery',
                    subtitle: 'How rested your body is today',
                    value: '${sleep.recoveryIndex.toStringAsFixed(0)}%',
                    iconColor: AppColors.activity,
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _StageTile extends StatelessWidget {
  final String title;
  final String duration;
  final String note;
  final Color color;

  const _StageTile({
    required this.title,
    required this.duration,
    required this.note,
    required this.color,
  });

  @override
  Widget build(BuildContext context) {
    return AppCard(
      radius: AppRadius.md,
      padding: const EdgeInsets.all(AppSpacing.sm),
      child: Row(
        children: [
          Container(
            width: 4,
            height: 34,
            decoration: BoxDecoration(
              color: color,
              borderRadius: AppRadius.brPill,
            ),
          ),
          AppSpacing.hGapSm,
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              mainAxisSize: MainAxisSize.min,
              children: [
                Text(
                  duration,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.headlineSmall,
                ),
                Text(
                  title,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.bodySmall.copyWith(
                    color: AppColors.textSecondary,
                    fontWeight: FontWeight.w600,
                  ),
                ),
                Text(
                  note,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.bodySmall.copyWith(
                    color: AppColors.textTertiary,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}
