import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import '../../core/services/prana_health_controller.dart';
import '../../shared/models/device_info.dart';
import '../../shared/widgets/section_header.dart';
import '../../shared/widgets/app_card.dart';
import '../../shared/widgets/fade_slide_in.dart';
import '../../shared/widgets/prana_scaffold.dart';
import '../../shared/widgets/status_pill.dart';
import '../../shared/widgets/stat_tile.dart';
import '../../shared/widgets/info_row.dart';
import '../../shared/widgets/empty_state.dart';

/// Wearable device status and connection controls.
class DeviceScreen extends StatelessWidget {
  const DeviceScreen({super.key});

  /// Returns a battery icon that reflects the current charge level.
  IconData _batteryIcon(int level) {
    if (level >= 90) return Icons.battery_full_rounded;
    if (level >= 70) return Icons.battery_6_bar_rounded;
    if (level >= 50) return Icons.battery_4_bar_rounded;
    if (level >= 30) return Icons.battery_3_bar_rounded;
    if (level >= 15) return Icons.battery_2_bar_rounded;
    return Icons.battery_1_bar_rounded;
  }

  Future<void> _scan(BuildContext context, PranaHealthController c) async {
    final messenger = ScaffoldMessenger.of(context);
    await c.startBleScan();
    messenger.showSnackBar(
      const SnackBar(
        content: Text('Looking for your PRANA sensor…'),
        duration: Duration(seconds: 4),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final controller = context.watch<PranaHealthController>();
    final device = controller.currentDevice;
    final isConnected = device.connectionState == DeviceConnectionState.connected;
    final isConnecting = device.connectionState == DeviceConnectionState.connecting;
    // "No device ever paired" heuristic — the initial mock device has a
    // non-empty name but id of the form 'mock:...' or 'ESP32:...'.
    // We show the empty state only when nothing has ever connected.
    final hasNeverConnected = !isConnected && !isConnecting && device.id.isEmpty;

    return PranaScaffold(
      title: 'Your device',
      subtitle: isConnected
          ? 'Connected and sending readings'
          : 'Sensor band and connection',
      body: hasNeverConnected
          ? Center(
              child: EmptyState(
                icon: Icons.watch_off_rounded,
                iconColor: AppColors.textTertiary,
                title: 'No device connected',
                subtitle:
                    'Connect your PRANA sensor band to start monitoring your '
                    'vitals.',
                actionLabel: 'Connect device',
                onAction: () => _scan(context, controller),
              ),
            )
          : SingleChildScrollView(
              padding: const EdgeInsets.fromLTRB(
                AppSpacing.md,
                AppSpacing.xxs,
                AppSpacing.md,
                AppSpacing.xl,
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  // ── Device hero ─────────────────────────────────────────────
                  FadeSlideIn(
                    index: 0,
                    child: AppCard(
                      elevated: true,
                      padding: const EdgeInsets.all(AppSpacing.lg),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Row(
                            children: [
                              Container(
                                width: 46,
                                height: 46,
                                decoration: BoxDecoration(
                                  color: isConnected
                                      ? AppColors.primaryContainer
                                      : AppColors.surfaceSubtle,
                                  borderRadius: AppRadius.brSm,
                                ),
                                child: Icon(
                                  Icons.watch_rounded,
                                  color: isConnected
                                      ? AppColors.primary
                                      : AppColors.textTertiary,
                                  size: 24,
                                ),
                              ),
                              AppSpacing.hGapSm,
                              Expanded(
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Text(
                                      device.name,
                                      maxLines: 1,
                                      overflow: TextOverflow.ellipsis,
                                      style: AppTypography.titleMedium,
                                    ),
                                    if (device.id.isNotEmpty)
                                      Text(
                                        device.id,
                                        maxLines: 1,
                                        overflow: TextOverflow.ellipsis,
                                        style: AppTypography.bodySmall,
                                      ),
                                  ],
                                ),
                              ),
                              AppSpacing.hGapXs,
                              StatusPill(
                                label: isConnected
                                    ? 'Connected'
                                    : (isConnecting
                                        ? 'Connecting'
                                        : 'Not connected'),
                                color: isConnected
                                    ? AppColors.riskSafe
                                    : (isConnecting
                                        ? AppColors.riskModerate
                                        : AppColors.offline),
                                backgroundColor: isConnected
                                    ? AppColors.riskSafeBg
                                    : (isConnecting
                                        ? AppColors.riskModerateBg
                                        : AppColors.surfaceSubtle),
                                showDot: true,
                                dense: true,
                              ),
                            ],
                          ),

                          // Battery / signal / firmware only mean something on a
                          // live link — no '--' filler when there isn't one.
                          if (isConnected) ...[
                            const Divider(height: AppSpacing.xl),
                            Row(
                              crossAxisAlignment: CrossAxisAlignment.stretch,
                              children: [
                                Expanded(
                                  child: StatTile(
                                    label: 'Battery',
                                    value: device.batteryLevel > 0
                                        ? '${device.batteryLevel}'
                                        : '—',
                                    unit: device.batteryLevel > 0 ? '%' : '',
                                    icon: device.batteryLevel > 0
                                        ? _batteryIcon(device.batteryLevel)
                                        : Icons.battery_unknown_rounded,
                                    valueColor: device.batteryLevel > 0 &&
                                            device.batteryLevel < 20
                                        ? AppColors.riskHigh
                                        : AppColors.activity,
                                  ),
                                ),
                                const SizedBox(width: AppSpacing.xs),
                                Expanded(
                                  child: StatTile(
                                    label: 'Signal',
                                    value:
                                        device.rssi != 0 ? '${device.rssi}' : '—',
                                    unit: device.rssi != 0 ? 'dBm' : '',
                                    icon: Icons.wifi_rounded,
                                    valueColor: AppColors.primary,
                                  ),
                                ),
                                const SizedBox(width: AppSpacing.xs),
                                Expanded(
                                  child: StatTile(
                                    label: 'Firmware',
                                    value: device.firmwareVersion.isNotEmpty
                                        ? device.firmwareVersion
                                        : '—',
                                    icon: Icons.memory_rounded,
                                  ),
                                ),
                              ],
                            ),
                          ],

                          const SizedBox(height: AppSpacing.lg),
                          if (isConnected)
                            SizedBox(
                              width: double.infinity,
                              child: OutlinedButton.icon(
                                style: OutlinedButton.styleFrom(
                                  foregroundColor: AppColors.riskCritical,
                                  side: const BorderSide(
                                    color: AppColors.riskCritical,
                                  ),
                                  padding: const EdgeInsets.symmetric(
                                    vertical: 12,
                                  ),
                                ),
                                onPressed: () async {
                                  final messenger =
                                      ScaffoldMessenger.of(context);
                                  await controller.disconnectBleDevice();
                                  messenger.showSnackBar(
                                    const SnackBar(
                                      content: Text('Device disconnected.'),
                                    ),
                                  );
                                },
                                icon: const Icon(
                                  Icons.bluetooth_disabled_rounded,
                                ),
                                label: const Text('Disconnect'),
                              ),
                            )
                          else
                            SizedBox(
                              width: double.infinity,
                              child: ElevatedButton.icon(
                                style: ElevatedButton.styleFrom(
                                  padding: const EdgeInsets.symmetric(
                                    vertical: 12,
                                  ),
                                ),
                                onPressed: isConnecting
                                    ? null
                                    : () => _scan(context, controller),
                                icon: isConnecting
                                    ? const SizedBox(
                                        width: 18,
                                        height: 18,
                                        child: CircularProgressIndicator(
                                          strokeWidth: 2,
                                          color: Colors.white,
                                        ),
                                      )
                                    : const Icon(
                                        Icons.bluetooth_searching_rounded,
                                      ),
                                label: Text(
                                  isConnecting
                                      ? 'Searching…'
                                      : 'Connect device',
                                ),
                              ),
                            ),
                        ],
                      ),
                    ),
                  ),

                  // ── Sensors ─────────────────────────────────────────────────
                  FadeSlideIn(
                    index: 1,
                    child: const SectionHeader(
                      title: 'Sensors',
                      subtitle: 'What your band is measuring',
                    ),
                  ),
                  FadeSlideIn(
                    index: 2,
                    child: AppCard(
                      padding: const EdgeInsets.symmetric(
                        horizontal: AppSpacing.md,
                      ),
                      child: Column(
                        children: [
                          _SensorRow(
                            icon: Icons.favorite_rounded,
                            title: 'Heart rate',
                            subtitle: 'Pulse and beat-to-beat variability',
                            isActive: device.isHeartRateActive,
                            color: AppColors.heartRate,
                          ),
                          const Divider(height: 1),
                          _SensorRow(
                            icon: Icons.water_drop_rounded,
                            title: 'Blood oxygen',
                            subtitle: 'Oxygen saturation in your blood',
                            isActive: device.isSpo2Active,
                            color: AppColors.spo2,
                          ),
                          const Divider(height: 1),
                          _SensorRow(
                            icon: Icons.thermostat_rounded,
                            title: 'Body temperature',
                            subtitle: 'Skin-contact thermometer',
                            isActive: device.isTemperatureActive,
                            color: AppColors.temperature,
                          ),
                          const Divider(height: 1),
                          _SensorRow(
                            icon: Icons.directions_run_rounded,
                            title: 'Movement',
                            subtitle: 'Steps and fall detection',
                            isActive: device.isMotionActive,
                            color: AppColors.activity,
                          ),
                        ],
                      ),
                    ),
                  ),
                ],
              ),
            ),
    );
  }
}

class _SensorRow extends StatelessWidget {
  final IconData icon;
  final String title;
  final String subtitle;
  final bool isActive;
  final Color color;

  const _SensorRow({
    required this.icon,
    required this.title,
    required this.subtitle,
    required this.isActive,
    required this.color,
  });

  @override
  Widget build(BuildContext context) {
    return InfoRow(
      icon: icon,
      title: title,
      subtitle: subtitle,
      iconColor: isActive ? color : AppColors.textTertiary,
      trailing: StatusPill(
        label: isActive ? 'Live' : 'Off',
        color: isActive ? AppColors.riskSafe : AppColors.textTertiary,
        backgroundColor: isActive ? AppColors.riskSafeBg : AppColors.surfaceSubtle,
        dense: true,
      ),
    );
  }
}
