/// Animated domain card — progress bar sweeps in on first display.
class _AnimatedDomainCard extends StatefulWidget {
  final String title;
  final double score;
  final Color color;
  final String explanation;

  const _AnimatedDomainCard({
    required this.title,
    required this.score,
    required this.color,
    required this.explanation,
  });

  @override
  State<_AnimatedDomainCard> createState() => _AnimatedDomainCardState();
}

class _AnimatedDomainCardState extends State<_AnimatedDomainCard>
    with SingleTickerProviderStateMixin {
  late AnimationController _ctrl;
  late Animation<double> _anim;

  @override
  void initState() {
    super.initState();
    _ctrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 800),
    );
    _anim = Tween<double>(begin: 0, end: widget.score).animate(
      CurvedAnimation(parent: _ctrl, curve: Curves.easeOutCubic),
    );
    _ctrl.forward();
  }

  @override
  void didUpdateWidget(covariant _AnimatedDomainCard old) {
    super.didUpdateWidget(old);
    if (old.score != widget.score) {
      _anim = Tween<double>(begin: old.score, end: widget.score).animate(
        CurvedAnimation(parent: _ctrl, curve: Curves.easeOutCubic),
      );
      _ctrl.forward(from: 0);
    }
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final percentage = (widget.score * 100).round();

    final RiskLevel level;
    if (percentage < 30) {
      level = RiskLevel.safe;
    } else if (percentage < 60) {
      level = RiskLevel.moderate;
    } else if (percentage < 80) {
      level = RiskLevel.high;
    } else {
      level = RiskLevel.critical;
    }

    return AnimatedBuilder(
      animation: _anim,
      builder: (context, _) {
        return Container(
          margin: const EdgeInsets.only(bottom: AppSpacing.xs),
          decoration: BoxDecoration(
            color: AppColors.surface,
            borderRadius: AppRadius.brLg,
            border: Border.all(color: AppColors.border),
            boxShadow: AppShadows.card,
          ),
          child: ClipRRect(
            borderRadius: AppRadius.brLg,
            child: IntrinsicHeight(
              child: Row(
                children: [
                  // Left accent bar
                  Container(width: 3, color: widget.color.withValues(alpha: 0.7)),
                  // Content
                  Expanded(
                    child: Padding(
                      padding: const EdgeInsets.all(AppSpacing.md),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Row(
                            children: [
                              Expanded(
                                child: Text(
                                  widget.title,
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: AppTypography.titleMedium,
                                ),
                              ),
                              AppSpacing.hGapXs,
                              Text(
                                '$percentage%',
                                style: AppTypography.titleMedium.copyWith(
                                  fontWeight: FontWeight.w800,
                                  color: widget.color,
                                ),
                              ),
                              AppSpacing.hGapXxs,
                              StatusPill(
                                label: level.displayName,
                                color: level.color,
                                backgroundColor: level.bgColor,
                                dense: true,
                                caps: true,
                              ),
                            ],
                          ),
                          AppSpacing.gapXs,
                          ClipRRect(
                            borderRadius: AppRadius.brPill,
                            child: LinearProgressIndicator(
                              value: _anim.value.clamp(0.0, 1.0),
                              backgroundColor: AppColors.borderLight,
                              valueColor: AlwaysStoppedAnimation<Color>(widget.color),
                              minHeight: 6,
                            ),
                          ),
                          const SizedBox(height: 7),
                          Text(widget.explanation, style: AppTypography.bodySmall),
                        ],
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }
}
