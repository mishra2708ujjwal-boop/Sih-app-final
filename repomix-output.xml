import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_spacing.dart';

/// The single card container for PRANA.
///
/// Replaces the ~25 hand-rolled `Container` + `BoxDecoration` blocks that had
/// drifted across 4/6/8/10/12/14/16/18/20px radii. Pass [accent] to tint the
/// surface and border with a semantic colour (risk level, biometric domain).
class AppCard extends StatelessWidget {
  final Widget child;
  final EdgeInsetsGeometry? padding;
  final EdgeInsetsGeometry? margin;
  final VoidCallback? onTap;

  /// Tints background + border. Use for risk/biometric emphasis.
  final Color? accent;

  /// Solid background override. Wins over [accent].
  final Color? color;

  /// Gradient background. Wins over [color] and [accent].
  final Gradient? gradient;

  final double radius;
  final bool showBorder;
  final bool elevated;

  const AppCard({
    super.key,
    required this.child,
    this.padding,
    this.margin,
    this.onTap,
    this.accent,
    this.color,
    this.gradient,
    this.radius = AppRadius.lg,
    this.showBorder = true,
    this.elevated = false,
  });

  @override
  Widget build(BuildContext context) {
    final borderRadius = BorderRadius.circular(radius);

    final Color bg = color ??
        (accent != null ? accent!.withValues(alpha: 0.06) : AppColors.surface);

    final Color borderColor =
        accent != null ? accent!.withValues(alpha: 0.22) : AppColors.border;

    final content = Container(
      padding: padding ?? AppSpacing.card,
      decoration: BoxDecoration(
        color: gradient == null ? bg : null,
        gradient: gradient,
        borderRadius: borderRadius,
        border: showBorder && gradient == null
            ? Border.all(color: borderColor, width: 1)
            : null,
        boxShadow: elevated ? AppShadows.raised : AppShadows.card,
      ),
      child: child,
    );

    return Container(
      margin: margin,
      child: onTap == null
          ? content
          : Material(
              color: Colors.transparent,
              borderRadius: borderRadius,
              child: InkWell(
                onTap: onTap,
                borderRadius: borderRadius,
                child: content,
              ),
            ),
    );
  }
}
</file>

