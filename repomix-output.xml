<file path="lib/shared/widgets/ambient_background.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';

/// Very subtle ambient wash painted behind a screen's content.
///
/// Two low-opacity radial washes plus one that drifts a few pixels over ~24s.
/// No blur filters and no repeated layout — the drift is a single small
/// `Transform` inside a `RepaintBoundary`, so it costs effectively nothing but
/// stops large flat areas from reading as dead space.
class AmbientBackground extends StatefulWidget {
  final Widget child;

  /// Tint of the upper wash. Defaults to the brand primary.
  final Color? tint;

  /// Tint of the lower wash. Defaults to a cooler secondary.
  final Color? secondaryTint;

  /// Base surface colour behind the washes.
  final Color? background;

  const AmbientBackground({
    super.key,
    required this.child,
    this.tint,
    this.secondaryTint,
    this.background,
  });

  @override
  State<AmbientBackground> createState() => _AmbientBackgroundState();
}

class _AmbientBackgroundState extends State<AmbientBackground>
    with SingleTickerProviderStateMixin {
  late final AnimationController _drift = AnimationController(
    vsync: this,
    duration: const Duration(seconds: 24),
  )..repeat(reverse: true);

  @override
  void dispose() {
    _drift.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final tint = widget.tint ?? AppColors.primary;
    final secondary = widget.secondaryTint ?? AppColors.primaryLight;
    final size = MediaQuery.sizeOf(context);

    return DecoratedBox(
      decoration: BoxDecoration(color: widget.background ?? AppColors.background),
      child: Stack(
        children: [
          Positioned.fill(
            child: IgnorePointer(
              child: RepaintBoundary(
                child: AnimatedBuilder(
                  animation: _drift,
                  builder: (context, _) {
                    final t = Curves.easeInOut.transform(_drift.value);
                    return Stack(
                      children: [
                        // Upper-right wash — drifts vertically.
                        Positioned(
                          right: -size.width * 0.34,
                          top: -size.width * 0.42 + (t * 14),
                          child: _Wash(
                            diameter: size.width * 1.05,
                            color: tint,
                            opacity: 0.075,
                          ),
                        ),
                        // Upper-left cool wash.
                        Positioned(
                          left: -size.width * 0.42,
                          top: size.width * 0.05 - (t * 10),
                          child: _Wash(
                            diameter: size.width * 0.92,
                            color: secondary,
                            opacity: 0.05,
                          ),
                        ),
                        // Low anchor wash so the fold of long pages isn't flat.
                        Positioned(
                          right: -size.width * 0.3,
                          bottom: -size.width * 0.3,
                          child: _Wash(
                            diameter: size.width * 0.8,
                            color: secondary,
                            opacity: 0.04,
                          ),
                        ),
                      ],
                    );
                  },
                ),
              ),
            ),
          ),
          widget.child,
        ],
      ),
    );
  }
}

class _Wash extends StatelessWidget {
  final double diameter;
  final Color color;
  final double opacity;

  const _Wash({
    required this.diameter,
    required this.color,
    required this.opacity,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      width: diameter,
      height: diameter,
      decoration: BoxDecoration(
        shape: BoxShape.circle,
        gradient: RadialGradient(
          colors: [
            color.withValues(alpha: opacity),
            color.withValues(alpha: 0),
          ],
          stops: const [0.0, 1.0],
        ),
      ),
    );
  }
}
</file>

<file path="lib/shared/widgets/animated_metric_value.dart">
import 'package:flutter/material.dart';

/// A metric readout that eases between values instead of snapping.
///
/// Non-numeric input (`'--'`, `'Learning'`) renders as plain text, so callers
/// can hand it whatever the controller produced without branching. Decimal
/// places are inferred from the incoming string so a temperature keeps its
/// single decimal and a heart rate stays whole.
class AnimatedMetricValue extends StatelessWidget {
  final String value;
  final TextStyle? style;
  final Duration duration;

  const AnimatedMetricValue({
    super.key,
    required this.value,
    this.style,
    this.duration = const Duration(milliseconds: 420),
  });

  @override
  Widget build(BuildContext context) {
    final numeric = double.tryParse(value);

    if (numeric == null) {
      return Text(
        value,
        maxLines: 1,
        overflow: TextOverflow.ellipsis,
        style: style,
      );
    }

    final dot = value.indexOf('.');
    final digits = dot == -1 ? 0 : value.length - dot - 1;

    return TweenAnimationBuilder<double>(
      tween: Tween<double>(end: numeric),
      duration: duration,
      curve: Curves.easeOutCubic,
      builder: (context, v, _) => Text(
        v.toStringAsFixed(digits),
        maxLines: 1,
        overflow: TextOverflow.ellipsis,
        style: style,
      ),
    );
  }
}
</file>

