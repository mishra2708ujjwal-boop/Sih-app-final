import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import '../../core/services/prana_health_controller.dart';
import '../../shared/widgets/risk_score_gauge.dart';
import '../../shared/widgets/health_metric_card.dart';
import '../../shared/widgets/scenario_banner.dart';
import '../../shared/widgets/section_header.dart';
import '../../shared/widgets/app_card.dart';
import '../../shared/widgets/stat_tile.dart';
import '../../shared/widgets/empty_state.dart';
import '../../shared/widgets/fade_slide_in.dart';
import '../../shared/widgets/loading_shimmer.dart';
import '../../shared/widgets/prana_scaffold.dart';
import '../../shared/widgets/status_pill.dart';
import '../../shared/models/risk_result.dart';
import '../../shared/models/device_info.dart';

/// Home — the screen that has to explain the product in a glance.
///
/// Reading order is deliberate: who you are → is monitoring running → what the
/// risk is → the vitals behind it → what to do → the environment around you.
/// Anything that could not be answered from live data is not rendered at all,
/// so the screen never shows a grid of `--`.
class DashboardScreen extends StatelessWidget {
  final VoidCallback onNavigateToVitals;
  final VoidCallback onNavigateToInsights;
  final VoidCallback onNavigateToEnvironment;
  final VoidCallback onNavigateToProfile;

  const DashboardScreen({
    super.key,
    required this.onNavigateToVitals,
    required this.onNavigateToInsights,
    required this.onNavigateToEnvironment,
    required this.onNavigateToProfile,
  });

  String _greeting() {
    final hour = DateTime.now().hour;
    if (hour < 12) return 'Good morning';
    if (hour < 17) return 'Good afternoon';
    return 'Good evening';
  }

  @override
  Widget build(BuildContext context) {
    final controller = context.watch<PranaHealthController>();
    final risk = controller.currentRisk;
    final health = controller.currentHealth;
    final env = controller.currentEnvironment;
    final baseline = controller.currentBaseline;
    final hasData = controller.hasLiveData;
    final device = controller.currentDevice;
    final isConnected = device.connectionState == DeviceConnectionState.connected;
    final profile = controller.userProfile;

    final hrDev =
        hasData ? controller.baselineService.getHrDeviationPercent(health.heartRate) : 0.0;
    final spo2Drop =
        hasData ? controller.baselineService.getSpo2DropPoints(health.spo2) : 0.0;
    final tempElev =
        hasData ? controller.baselineService.getTempElevation(health.bodyTemperature) : 0.0;

    final nameParts = profile.name.trim().split(' ');
    final initials = nameParts.length >= 2
        ? '${nameParts.first[0]}${nameParts.last[0]}'.toUpperCase()
        : profile.name.isNotEmpty
            ? profile.name[0].toUpperCase()
            : 'P';

    // Baseline needs a few hours of real readings before its bounds mean
    // anything. Say so instead of presenting them as settled fact.
    final isLearning = baseline.totalReadingsLearned < 60;

    var order = 0;

    return PranaScaffold(
      tint: hasData ? risk.level.color : AppColors.primary,
      titleOverride: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            _greeting(),
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: AppTypography.bodySmall.copyWith(
              color: AppColors.textTertiary,
              fontWeight: FontWeight.w500,
            ),
          ),
          Text(
            profile.name.trim().isEmpty ? 'PRANA' : nameParts.first,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: AppTypography.headlineLarge,
          ),
        ],
      ),
      actions: [
        Padding(
          padding: const EdgeInsets.only(right: AppSpacing.sm),
          child: Semantics(
            button: true,
            label: 'Open your profile',
            child: InkWell(
              onTap: onNavigateToProfile,
              customBorder: const CircleBorder(),
              child: Container(
                width: 38,
                height: 38,
                decoration: const BoxDecoration(
                  gradient: LinearGradient(
                    colors: AppColors.gradientPrimary,
                    begin: Alignment.topLeft,
                    end: Alignment.bottomRight,
                  ),
                  shape: BoxShape.circle,
                ),
                child: Center(
                  child: Text(
                    initials,
                    style: const TextStyle(
                      fontSize: 14,
                      fontWeight: FontWeight.w700,
                      color: Colors.white,
                      letterSpacing: 0.5,
                    ),
                  ),
                ),
              ),
            ),
          ),
        ),
      ],
      body: SingleChildScrollView(
        padding: const EdgeInsets.fromLTRB(
          AppSpacing.md,
          AppSpacing.xxs,
          AppSpacing.md,
          AppSpacing.navClearance,
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // ── Monitoring status ────────────────────────────────────────────
            FadeSlideIn(
              index: order++,
              child: _MonitoringStatus(
                device: device,
                isMockMode: controller.isMockMode,
                hasData: hasData,
                onConnect: () => _scan(context, controller),
              ),
            ),
            AppSpacing.gapSm,

            // ── Primary status ───────────────────────────────────────────────
            FadeSlideIn(
              index: order++,
              child: hasData
                  ? _RiskHero(risk: risk)
                  : _AwaitingData(
                      isConnected: isConnected,
                      isConnecting:
                          device.connectionState == DeviceConnectionState.connecting,
                      onConnect: () => _scan(context, controller),
                    ),
            ),

            if (hasData) ...[
              // ── Key vitals ─────────────────────────────────────────────────
              SectionHeader(
                title: 'Vitals',
                subtitle: 'Live readings against your baseline',
                actionLabel: 'See all',
                onAction: onNavigateToVitals,
              ),
              FadeSlideIn(
                index: order++,
                child: LayoutBuilder(
                  builder: (context, constraints) {
                    // Two columns, but the cell height follows the text scale
                    // instead of a fixed aspect ratio so large-font users don't
                    // get clipped values.
                    final cellWidth =
                        (constraints.maxWidth - AppSpacing.sm) / 2;
                    final scale = MediaQuery.textScalerOf(context).scale(1);
                    final cellHeight = (cellWidth / 1.12) * (scale > 1 ? scale * 0.94 : 1);

                    return GridView.count(
                      crossAxisCount: 2,
                      crossAxisSpacing: AppSpacing.sm,
                      mainAxisSpacing: AppSpacing.sm,
                      childAspectRatio: cellWidth / cellHeight,
                      shrinkWrap: true,
                      physics: const NeverScrollableScrollPhysics(),
                      children: [
                        HealthMetricCard(
                          title: 'Heart rate',
                          value: health.heartRate.toStringAsFixed(0),
                          unit: 'BPM',
                          baselineRange:
                              '${baseline.normalHrMin.toStringAsFixed(0)}–${baseline.normalHrMax.toStringAsFixed(0)} BPM',
                          deltaText: hrDev > 0
                              ? '+${hrDev.toStringAsFixed(0)}%'
                              : 'Normal',
                          isNormal: hrDev <= 5.0,
                          icon: Icons.favorite_rounded,
                          accentColor: AppColors.heartRate,
                          bgColor: AppColors.heartRateBg,
                          onTap: onNavigateToVitals,
                        ),
                        HealthMetricCard(
                          title: 'Blood oxygen',
                          value: health.spo2.toStringAsFixed(0),
                          unit: '%',
                          baselineRange:
                              'Above ${baseline.normalSpo2Min.toStringAsFixed(0)}%',
                          deltaText: spo2Drop > 0
                              ? '-${spo2Drop.toStringAsFixed(1)}%'
                              : 'Normal',
                          isNormal: spo2Drop <= 1.0,
                          icon: Icons.water_drop_rounded,
                          accentColor: AppColors.spo2,
                          bgColor: AppColors.spo2Bg,
                          onTap: onNavigateToVitals,
                        ),
                        HealthMetricCard(
                          title: 'Body temp',
                          value: health.bodyTemperature.toStringAsFixed(1),
                          unit: '°C',
                          baselineRange:
                              '${baseline.normalTempMin.toStringAsFixed(1)}–${baseline.normalTempMax.toStringAsFixed(1)} °C',
                          deltaText: tempElev > 0
                              ? '+${tempElev.toStringAsFixed(1)}°'
                              : 'Normal',
                          isNormal: tempElev <= 0.2,
                          icon: Icons.thermostat_rounded,
                          accentColor: AppColors.temperature,
                          bgColor: AppColors.temperatureBg,
                          onTap: onNavigateToVitals,
                        ),
                        HealthMetricCard(
                          title: 'Steps today',
                          value: '${health.steps}',
                          unit: 'steps',
                          baselineRange: 'Goal 8,000',
                          deltaText: health.activityLevel,
                          isNormal: true,
                          icon: Icons.directions_walk_rounded,
                          accentColor: AppColors.activity,
                          bgColor: AppColors.activityBg,
                          onTap: onNavigateToVitals,
                        ),
                      ],
                    );
                  },
                ),
              ),

              // ── What to do ─────────────────────────────────────────────────
              SectionHeader(
                title: 'What this means',
                subtitle: 'From the model running on your phone',
                actionLabel: 'Full analysis',
                onAction: onNavigateToInsights,
              ),
              FadeSlideIn(
                index: order++,
                child: _InsightCard(
                  risk: risk,
                  onTap: onNavigateToInsights,
                ),
              ),

              // ── Environment ────────────────────────────────────────────────
              SectionHeader(
                title: 'Around you',
                subtitle: 'Conditions factored into your score',
                actionLabel: 'Details',
                onAction: onNavigateToEnvironment,
              ),
              FadeSlideIn(
                index: order++,
                child: AppCard(
                  onTap: onNavigateToEnvironment,
                  padding: const EdgeInsets.symmetric(
                    horizontal: AppSpacing.md,
                    vertical: AppSpacing.md,
                  ),
                  child: Column(
                    children: [
                      Row(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Expanded(
                            child: StatTile(
                              icon: Icons.thermostat_outlined,
                              value: '${env.temperature}',
                              unit: '°C',
                              label: 'Air temperature',
                              accent: AppColors.temperature,
                            ),
                          ),
                          Expanded(
                            child: StatTile(
                              icon: Icons.water_drop_outlined,
                              value: '${env.humidity}',
                              unit: '%',
                              label: 'Humidity',
                              accent: AppColors.humidity,
                            ),
                          ),
                        ],
                      ),
                      const Divider(height: AppSpacing.xl),
                      Row(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Expanded(
                            child: StatTile(
                              icon: Icons.air_rounded,
                              value: '${env.aqi}',
                              label: 'Air quality · ${env.aqiCategory}',
                              accent: AppColors.aqi,
                            ),
                          ),
                          Expanded(
                            child: StatTile(
                              icon: Icons.local_fire_department_outlined,
                              value: '${env.heatIndex}',
                              unit: '°C',
                              label: 'Feels like',
                              accent: AppColors.heatIndex,
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
              ),

              // ── Baseline still calibrating ─────────────────────────────────
              if (isLearning) ...[
                AppSpacing.gapSm,
                FadeSlideIn(
                  index: order++,
                  child: AppCard(
                    color: AppColors.surfaceSubtle,
                    padding: const EdgeInsets.all(AppSpacing.sm + 2),
                    child: Row(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        const Icon(
                          Icons.timeline_rounded,
                          size: 17,
                          color: AppColors.textTertiary,
                        ),
                        AppSpacing.hGapSm,
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                'Learning your baseline',
                                style: AppTypography.labelLarge,
                              ),
                              const SizedBox(height: 2),
                              Text(
                                'PRANA needs more real readings to understand your '
                                'normal pattern. Comparisons will sharpen as it learns.',
                                style: AppTypography.bodySmall.copyWith(
                                  color: AppColors.textSecondary,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ],

            // ── Demo scenario switcher (demo mode only) ──────────────────────
            if (controller.isMockMode) ...[
              AppSpacing.gapMd,
              ScenarioBanner(
                currentScenario: controller.currentScenario,
                onScenarioChanged: controller.selectDisasterScenario,
              ),
            ],
          ],
        ),
      ),
    );
  }

  Future<void> _scan(
    BuildContext context,
    PranaHealthController controller,
  ) async {
    final messenger = ScaffoldMessenger.of(context);
    await controller.startBleScan();
    messenger.showSnackBar(
      const SnackBar(
        content: Text('Looking for your PRANA sensor…'),
        duration: Duration(seconds: 4),
      ),
    );
  }
}

// ── Monitoring status ─────────────────────────────────────────────────────────
/// One honest line about whether PRANA is actually watching right now.
class _MonitoringStatus extends StatelessWidget {
  final DeviceInfo device;
  final bool isMockMode;
  final bool hasData;
  final VoidCallback onConnect;

  const _MonitoringStatus({
    required this.device,
    required this.isMockMode,
    required this.hasData,
    required this.onConnect,
  });

  @override
  Widget build(BuildContext context) {
    final isConnected = device.connectionState == DeviceConnectionState.connected;
    final isConnecting = device.connectionState == DeviceConnectionState.connecting;

    late final Color accent;
    late final String title;
    late final String subtitle;

    if (isMockMode) {
      accent = AppColors.primaryLight;
      title = 'Demo mode';
      subtitle = 'Simulated readings — no wearable needed';
    } else if (isConnected) {
      accent = AppColors.riskSafe;
      title = hasData ? 'Monitoring active' : 'Sensor connected';
      subtitle = hasData
          ? 'Everything is processed on this phone'
          : 'Waiting for the first readings';
    } else if (isConnecting) {
      accent = AppColors.riskModerate;
      title = 'Connecting…';
      subtitle = 'Pairing with ${device.name}';
    } else {
      accent = AppColors.textTertiary;
      title = 'Sensor not connected';
      subtitle = 'Tap to scan for your PRANA band';
    }

    final showLowBattery =
        isConnected && device.batteryLevel > 0 && device.batteryLevel < 25;

    return AppCard(
      onTap: isConnected || isConnecting || isMockMode ? null : onConnect,
      padding: const EdgeInsets.symmetric(
        horizontal: AppSpacing.md,
        vertical: AppSpacing.sm + 1,
      ),
      child: Row(
        children: [
          _PulseDot(color: accent, active: isConnected || isMockMode),
          AppSpacing.hGapSm,
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  title,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.labelLarge,
                ),
                const SizedBox(height: 1),
                Text(
                  subtitle,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.bodySmall,
                ),
              ],
            ),
          ),
          if (showLowBattery) ...[
            AppSpacing.hGapXs,
            StatusPill(
              label: '${device.batteryLevel}%',
              color: AppColors.riskHigh,
              backgroundColor: AppColors.riskHighBg,
              icon: Icons.battery_2_bar_rounded,
              dense: true,
            ),
          ] else if (!isConnected && !isConnecting && !isMockMode) ...[
            AppSpacing.hGapXs,
            Text(
              'Connect',
              style: AppTypography.labelMedium.copyWith(
                color: AppColors.primary,
                fontWeight: FontWeight.w700,
              ),
            ),
            const Icon(
              Icons.chevron_right_rounded,
              size: 18,
              color: AppColors.primary,
            ),
          ],
        ],
      ),
    );
  }
}

/// A dot with a slow halo. Only animates while monitoring is actually live, so
/// a disconnected band never looks busy.
class _PulseDot extends StatefulWidget {
  final Color color;
  final bool active;

  const _PulseDot({required this.color, required this.active});

  @override
  State<_PulseDot> createState() => _PulseDotState();
}

class _PulseDotState extends State<_PulseDot>
    with SingleTickerProviderStateMixin {
  late final AnimationController _ctrl = AnimationController(
    vsync: this,
    duration: const Duration(milliseconds: 2000),
  );

  @override
  void initState() {
    super.initState();
    if (widget.active) _ctrl.repeat();
  }

  @override
  void didUpdateWidget(covariant _PulseDot old) {
    super.didUpdateWidget(old);
    if (widget.active && !_ctrl.isAnimating) {
      _ctrl.repeat();
    } else if (!widget.active && _ctrl.isAnimating) {
      _ctrl.stop();
      _ctrl.value = 0;
    }
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    const core = 9.0;

    return SizedBox(
      width: 22,
      height: 22,
      child: Center(
        child: Stack(
          alignment: Alignment.center,
          children: [
            if (widget.active)
              AnimatedBuilder(
                animation: _ctrl,
                builder: (context, _) {
                  final t = Curves.easeOut.transform(_ctrl.value);
                  return Container(
                    width: core + (t * 13),
                    height: core + (t * 13),
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: widget.color.withValues(alpha: 0.22 * (1 - t)),
                    ),
                  );
                },
              ),
            Container(
              width: core,
              height: core,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: widget.color,
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// ── Risk hero ─────────────────────────────────────────────────────────────────
class _RiskHero extends StatelessWidget {
  final RiskResult risk;

  const _RiskHero({required this.risk});

  String _headline(RiskLevel level) {
    switch (level) {
      case RiskLevel.safe:
        return 'Vitals normal and steady';
      case RiskLevel.moderate:
        return 'Slightly outside your normal';
      case RiskLevel.high:
        return 'Your body is under strain';
      case RiskLevel.critical:
        return 'Act now — vitals are critical';
    }
  }

  @override
  Widget build(BuildContext context) {
    return AppCard(
      elevated: true,
      color: AppColors.surfaceHero,
      padding: const EdgeInsets.fromLTRB(
        AppSpacing.lg,
        AppSpacing.lg,
        AppSpacing.lg,
        AppSpacing.md,
      ),
      child: Column(
        children: [
          RiskScoreGauge(
            score: risk.overallScore,
            level: risk.level,
            trend: risk.trend,
            size: 172,
          ),
          AppSpacing.gapSm,
          AnimatedSwitcher(
            duration: const Duration(milliseconds: 260),
            child: Text(
              _headline(risk.level),
              key: ValueKey(risk.level),
              textAlign: TextAlign.center,
              style: AppTypography.headlineSmall.copyWith(
                color: risk.level.color,
                fontWeight: FontWeight.w700,
              ),
            ),
          ),
          const SizedBox(height: 5),
          Text(
            'Calculated from your last 20 minutes of readings',
            textAlign: TextAlign.center,
            style: AppTypography.bodySmall,
          ),
        ],
      ),
    );
  }
}

// ── Insight ───────────────────────────────────────────────────────────────────
class _InsightCard extends StatelessWidget {
  final RiskResult risk;
  final VoidCallback onTap;

  const _InsightCard({required this.risk, required this.onTap});

  @override
  Widget build(BuildContext context) {
    // Two strongest contributors, largest first. Anything beyond that belongs
    // on the Insights screen, not here.
    final drivers = [...risk.drivers]
      ..sort((a, b) => b.impactPercentage.compareTo(a.impactPercentage));
    final top = drivers.take(2).toList();

    return AppCard(
      onTap: onTap,
      accent: risk.level.color,
      color: risk.level.bgColor,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Container(
                padding: const EdgeInsets.all(8),
                decoration: BoxDecoration(
                  color: AppColors.surface,
                  borderRadius: AppRadius.brSm,
                ),
                child: Icon(
                  Icons.auto_awesome_rounded,
                  size: 17,
                  color: risk.level.color,
                ),
              ),
              AppSpacing.hGapSm,
              Expanded(
                child: Text(
                  risk.primaryRecommendation,
                  style: AppTypography.bodyMedium.copyWith(
                    color: AppColors.textPrimary,
                    fontWeight: FontWeight.w500,
                  ),
                ),
              ),
            ],
          ),
          if (top.isNotEmpty) ...[
            const Divider(height: AppSpacing.lg),
            for (var i = 0; i < top.length; i++)
              Padding(
                padding: EdgeInsets.only(
                  bottom: i == top.length - 1 ? 0 : AppSpacing.xs,
                ),
                child: Row(
                  children: [
                    Icon(top[i].icon, size: 15, color: risk.level.color),
                    AppSpacing.hGapXs,
                    Expanded(
                      child: Text.rich(
                        TextSpan(
                          children: [
                            TextSpan(
                              text: '${top[i].title}  ',
                              style: AppTypography.bodySmall.copyWith(
                                color: AppColors.textPrimary,
                                fontWeight: FontWeight.w700,
                              ),
                            ),
                            TextSpan(
                              text: top[i].description,
                              style: AppTypography.bodySmall.copyWith(
                                color: AppColors.textSecondary,
                              ),
                            ),
                          ],
                        ),
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                  ],
                ),
              ),
          ],
        ],
      ),
    );
  }
}

// ── No data yet ───────────────────────────────────────────────────────────────
class _AwaitingData extends StatelessWidget {
  final bool isConnected;
  final bool isConnecting;
  final VoidCallback onConnect;

  const _AwaitingData({
    required this.isConnected,
    required this.isConnecting,
    required this.onConnect,
  });

  @override
  Widget build(BuildContext context) {
    // Connected with no stream yet is a *loading* state, not an empty one.
    // Skeletons stand in for the vitals grid that is about to arrive — they
    // read as "on its way" without inventing a value to fill the space.
    if (isConnected) {
      return const Column(
        children: [
          AppCard(
            color: AppColors.surfaceHero,
            child: EmptyState(
              compact: true,
              icon: Icons.sensors_rounded,
              iconColor: AppColors.primary,
              title: 'Waiting for readings',
              subtitle:
                  'Your sensor is connected. The first vitals appear here '
                  'within a few seconds of wearing it.',
            ),
          ),
          AppSpacing.gapSm,
          Row(
            children: [
              Expanded(child: LoadingShimmer.card()),
              AppSpacing.hGapSm,
              Expanded(child: LoadingShimmer.card()),
            ],
          ),
        ],
      );
    }

    return AppCard(
      color: AppColors.surfaceHero,
      child: EmptyState(
        icon: Icons.watch_rounded,
        iconColor: AppColors.primary,
        title: 'No device connected',
        subtitle: 'Connect your PRANA sensor to begin monitoring.',
        actionLabel: isConnecting ? null : 'Connect device',
        onAction: isConnecting ? null : onConnect,
      ),
    );
  }
}
