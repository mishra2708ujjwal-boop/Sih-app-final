<file path="lib/shared/widgets/hypnogram_chart.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import 'app_card.dart';

/// Hypnogram Sleep Stage Visualizer (Awake, REM, Light, Deep)
class HypnogramChart extends StatelessWidget {
  final List<int> stages; // 0: Awake, 1: Light, 2: Deep, 3: REM
  final double height;

  const HypnogramChart({
    super.key,
    required this.stages,
    this.height = 120.0,
  });

  Color _getStageColor(int stage) {
    switch (stage) {
      case 0:
        return const Color(0xFFEF4444); // Awake: Coral/Red
      case 1:
        return const Color(0xFF60A5FA); // Light: Light Blue
      case 2:
        return const Color(0xFF1E3A8A); // Deep: Navy
      case 3:
        return const Color(0xFF8B5CF6); // REM: Purple
      default:
        return AppColors.border;
    }
  }

  @override
  Widget build(BuildContext context) {
    return AppCard(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text('Sleep Architecture', style: AppTypography.titleMedium),
          AppSpacing.gapXs,
          // Four legend entries used to share the title's Row — at 360dp the
          // title and legend fought for the same ~100dp. The legend wraps now.
          Wrap(
            spacing: AppSpacing.sm,
            runSpacing: AppSpacing.xxs,
            children: [
              _legendDot(const Color(0xFF1E3A8A), 'Deep'),
              _legendDot(const Color(0xFF8B5CF6), 'REM'),
              _legendDot(const Color(0xFF60A5FA), 'Light'),
              _legendDot(const Color(0xFFEF4444), 'Awake'),
            ],
          ),
          AppSpacing.gapSm,
          SizedBox(
            height: height,
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: stages.map((stage) {
                double stageHeightFactor;
                switch (stage) {
                  case 0:
                    stageHeightFactor = 0.25;
                    break;
                  case 1:
                    stageHeightFactor = 0.55;
                    break;
                  case 3:
                    stageHeightFactor = 0.80;
                    break;
                  case 2:
                    stageHeightFactor = 1.0;
                    break;
                  default:
                    stageHeightFactor = 0.5;
                }

                return Expanded(
                  child: Container(
                    margin: const EdgeInsets.symmetric(horizontal: 1.5),
                    height: height * stageHeightFactor,
                    decoration: BoxDecoration(
                      color: _getStageColor(stage),
                      borderRadius: BorderRadius.circular(3),
                    ),
                  ),
                );
              }).toList(),
            ),
          ),
          AppSpacing.gapXs,
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text('11:00 PM', style: AppTypography.bodySmall),
              Text('03:30 AM', style: AppTypography.bodySmall),
              Text('07:00 AM', style: AppTypography.bodySmall),
            ],
          ),
        ],
      ),
    );
  }

  Widget _legendDot(Color color, String label) {
    return Row(
      mainAxisSize: MainAxisSize.min,
      children: [
        Container(
          width: 8,
          height: 8,
          decoration: BoxDecoration(color: color, shape: BoxShape.circle),
        ),
        const SizedBox(width: 3),
        Text(label, style: AppTypography.bodySmall),
      ],
    );
  }
}
</file>

<file path="lib/shared/widgets/info_row.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';

/// Icon + title + subtitle (+ optional trailing) row.
///
/// Replaces six independent reimplementations of the same layout:
/// `_advisoryRow`, `_biomarkerRow`, `_sensorRow`, `_insightFeedItem`,
/// `_auditRow`, `_baselineItem`.
class InfoRow extends StatelessWidget {
  final IconData icon;
  final String title;
  final String? subtitle;

  /// Right-aligned value text. Ignored when [trailing] is supplied.
  final String? value;

  /// Fully custom trailing widget (pill, switch, chevron).
  final Widget? trailing;

  final Color? iconColor;
  final Color? valueColor;
  final VoidCallback? onTap;

  /// Show a chevron and treat the row as navigational.
  final bool showChevron;

  /// Render on a dark surface (privacy audit, demo lab).
  final bool onDark;

  const InfoRow({
    super.key,
    required this.icon,
    required this.title,
    this.subtitle,
    this.value,
    this.trailing,
    this.iconColor,
    this.valueColor,
    this.onTap,
    this.showChevron = false,
    this.onDark = false,
  });

  @override
  Widget build(BuildContext context) {
    final accent = iconColor ?? AppColors.primary;

    final titleColor = onDark ? Colors.white : AppColors.textPrimary;
    final subtitleColor =
        onDark ? Colors.white.withValues(alpha: 0.62) : AppColors.textSecondary;

    Widget? resolvedTrailing = trailing;
    if (resolvedTrailing == null && value != null) {
      resolvedTrailing = Text(
        value!,
        style: AppTypography.titleMedium.copyWith(
          color: valueColor ?? titleColor,
          fontWeight: FontWeight.w700,
        ),
        textAlign: TextAlign.right,
      );
    }
    if (resolvedTrailing == null && showChevron) {
      resolvedTrailing = Icon(
        Icons.chevron_right_rounded,
        size: 22,
        color: onDark ? Colors.white38 : AppColors.textTertiary,
      );
    }

    final row = Padding(
      padding: const EdgeInsets.symmetric(vertical: AppSpacing.sm),
      child: Row(
        children: [
          Container(
            width: 40,
            height: 40,
            decoration: BoxDecoration(
              color: accent.withValues(alpha: onDark ? 0.20 : 0.10),
              borderRadius: AppRadius.brSm,
            ),
            child: Icon(icon, size: 20, color: onDark ? Colors.white : accent),
          ),
          AppSpacing.hGapSm,
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              mainAxisSize: MainAxisSize.min,
              children: [
                Text(
                  title,
                  style: AppTypography.titleMedium.copyWith(color: titleColor),
                ),
                if (subtitle != null) ...[
                  const SizedBox(height: 2),
                  Text(
                    subtitle!,
                    style: AppTypography.bodySmall.copyWith(color: subtitleColor),
                  ),
                ],
              ],
            ),
          ),
          if (resolvedTrailing != null) ...[
            AppSpacing.hGapXs,
            // Cap the trailing width so a long value can never squeeze the
            // title column to zero and trigger an overflow.
            ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 130),
              child: resolvedTrailing,
            ),
          ],
        ],
      ),
    );

    if (onTap == null) return row;

    return Material(
      color: Colors.transparent,
      child: InkWell(
        onTap: onTap,
        borderRadius: AppRadius.brSm,
        child: row,
      ),
    );
  }
}
</file>

<file path="lib/shared/widgets/loading_shimmer.dart">
import 'package:flutter/material.dart';
import '../../core/theme/app_spacing.dart';

/// Lightweight shimmer placeholder — no external packages, just Flutter's
/// built-in animation stack. Used on metric cards while `hasData == false`
/// so the layout doesn't jump when data first arrives.
class LoadingShimmer extends StatefulWidget {
  final double width;
  final double height;
  final double borderRadius;

  const LoadingShimmer({
    super.key,
    this.width = double.infinity,
    this.height = 16,
    this.borderRadius = AppRadius.sm,
  });

  /// A preset that matches the metric value text height.
  const LoadingShimmer.metricValue({super.key})
      : width = 72,
        height = 36,
        borderRadius = AppRadius.sm;

  /// A preset that matches a full card.
  const LoadingShimmer.card({super.key})
      : width = double.infinity,
        height = 100,
        borderRadius = AppRadius.lg;

  @override
  State<LoadingShimmer> createState() => _LoadingShimmerState();
}

class _LoadingShimmerState extends State<LoadingShimmer>
    with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _animation;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1400),
    )..repeat();
    _animation = Tween<double>(begin: -1.5, end: 2.5).animate(
      CurvedAnimation(parent: _controller, curve: Curves.easeInOut),
    );
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _animation,
      builder: (context, child) {
        return Container(
          width: widget.width,
          height: widget.height,
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(widget.borderRadius),
            gradient: LinearGradient(
              begin: Alignment.centerLeft,
              end: Alignment.centerRight,
              stops: [
                (_animation.value - 0.5).clamp(0.0, 1.0),
                _animation.value.clamp(0.0, 1.0),
                (_animation.value + 0.5).clamp(0.0, 1.0),
              ],
              colors: const [
                Color(0xFFECEFF4),
                Color(0xFFF8FAFC),
                Color(0xFFECEFF4),
              ],
            ),
          ),
        );
      },
    );
  }
}
</file>

<file path="lib/shared/widgets/prana_scaffold.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import 'ambient_background.dart';

/// The single page shell for PRANA.
///
/// Replaces the per-screen `Scaffold` + `AppBar` pairs so every screen gets the
/// same large title, the same ambient background wash and the same header
/// rhythm. [headerBottom] is for content that belongs with the title rather
/// than with the scrolling body — a segmented control, for example.
class PranaScaffold extends StatelessWidget {
  /// Screen title. Ignored when [titleOverride] is supplied.
  final String? title;

  /// Optional one-line caption under the title.
  final String? subtitle;

  /// Replaces the whole title block. Use for bespoke headers (the dashboard).
  final Widget? titleOverride;

  final List<Widget> actions;

  /// Pinned under the header, above [body].
  final Widget? headerBottom;

  final Widget body;

  /// Ambient wash tint. Defaults to the brand primary.
  final Color? tint;

  /// Forces the back button on or off. Defaults to whether the route can pop.
  final bool? showBack;

  const PranaScaffold({
    super.key,
    this.title,
    this.subtitle,
    this.titleOverride,
    this.actions = const [],
    this.headerBottom,
    required this.body,
    this.tint,
    this.showBack,
  });

  @override
  Widget build(BuildContext context) {
    final canPop = showBack ?? Navigator.of(context).canPop();

    return Scaffold(
      backgroundColor: AppColors.background,
      body: AmbientBackground(
        tint: tint,
        child: SafeArea(
          bottom: false,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              Padding(
                padding: EdgeInsets.fromLTRB(
                  canPop ? AppSpacing.xxs : AppSpacing.md,
                  AppSpacing.xs,
                  AppSpacing.xs,
                  AppSpacing.sm,
                ),
                child: Row(
                  children: [
                    if (canPop)
                      IconButton(
                        onPressed: () => Navigator.of(context).maybePop(),
                        icon: const Icon(Icons.arrow_back_rounded),
                        color: AppColors.textPrimary,
                        tooltip: 'Back',
                      ),
                    Expanded(
                      child: titleOverride ??
                          Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Text(
                                title ?? '',
                                maxLines: 1,
                                overflow: TextOverflow.ellipsis,
                                style: AppTypography.headlineLarge,
                              ),
                              if (subtitle != null)
                                Padding(
                                  padding: const EdgeInsets.only(top: 2),
                                  child: Text(
                                    subtitle!,
                                    maxLines: 1,
                                    overflow: TextOverflow.ellipsis,
                                    style: AppTypography.bodySmall.copyWith(
                                      color: AppColors.textSecondary,
                                    ),
                                  ),
                                ),
                            ],
                          ),
                    ),
                    ...actions,
                  ],
                ),
              ),
              if (headerBottom != null)
                Padding(
                  padding: const EdgeInsets.fromLTRB(
                    AppSpacing.md,
                    0,
                    AppSpacing.md,
                    AppSpacing.sm,
                  ),
                  child: headerBottom!,
                ),
              Expanded(child: body),
            ],
          ),
        ),
      ),
    );
  }
}
