import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import '../../core/services/prana_health_controller.dart';
import '../../shared/widgets/section_header.dart';
import '../../shared/widgets/app_card.dart';
import '../../shared/widgets/info_row.dart';
import '../../shared/widgets/empty_state.dart';
import '../../shared/widgets/fade_slide_in.dart';

/// Environmental awareness body — embedded as the "Environment" segment of Insights.
class EnvironmentView extends StatelessWidget {
  const EnvironmentView({super.key});

  @override
  Widget build(BuildContext context) {
    final controller = context.watch<PranaHealthController>();
    final env = controller.currentEnvironment;
    final health = controller.currentHealth;
    final risk = controller.currentRisk;
    final hasData = controller.hasLiveData;

    const padding = EdgeInsets.fromLTRB(
      AppSpacing.md,
      AppSpacing.xxs,
      AppSpacing.md,
      AppSpacing.navClearance,
    );

    if (!hasData) {
      return SingleChildScrollView(
        padding: padding,
        child: AppCard(
          child: EmptyState(
            icon: Icons.cloud_outlined,
            title: 'No conditions yet',
            subtitle:
                'Your PRANA sensor measures the heat, humidity and air quality '
                'around you. Connect it to see what your body is dealing with.',
            actionLabel: 'Connect device',
            onAction: () => controller.startBleScan(),
          ),
        ),
      );
    }

    final hrDev = controller.baselineService.getHrDeviationPercent(
      health.heartRate,
    );
    final isStrained = risk.heatStressRisk > 0.5;
    final harsh = env.heatIndex > 38.0 || env.aqi > 200;
    var order = 0;

    return SingleChildScrollView(
      padding: padding,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // ── What the conditions mean for this person ─────────────────────
          FadeSlideIn(
            index: order++,
            child: AppCard(
              elevated: true,
              accent: isStrained ? AppColors.riskHigh : null,
              color: isStrained ? AppColors.riskHighBg : AppColors.surfaceHero,
              padding: const EdgeInsets.all(AppSpacing.lg),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      Icon(
                        Icons.bolt_rounded,
                        size: 16,
                        color: isStrained
                            ? AppColors.riskHigh
                            : AppColors.primary,
                      ),
                      const SizedBox(width: 6),
                      Text(
                        'How this affects you',
                        style: AppTypography.labelMedium.copyWith(
                          color: isStrained
                              ? AppColors.riskHigh
                              : AppColors.primary,
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                    ],
                  ),
                  AppSpacing.gapSm,
                  Text(
                    harsh
                        ? 'Conditions are pushing your body harder'
                        : 'Conditions around you look easy on your body',
                    style: AppTypography.headlineSmall,
                  ),
                  AppSpacing.gapXs,
                  Text(
                    'It’s ${env.temperature}°C with ${env.humidity}% humidity and '
                    'air quality at ${env.aqi} AQI. Your heart rate is '
                    '${health.heartRate.toStringAsFixed(0)} BPM '
                    '(${hrDev > 0 ? "${hrDev.toStringAsFixed(0)}% above your normal" : "normal"}) '
                    'and your blood oxygen is ${health.spo2}%.',
                    style: AppTypography.bodyMedium,
                  ),
                ],
              ),
            ),
          ),

          // ── Readings ─────────────────────────────────────────────────────
          FadeSlideIn(
            index: order++,
            child: const SectionHeader(
              title: 'Conditions',
              subtitle: 'Measured around you right now',
            ),
          ),
          FadeSlideIn(
            index: order++,
            child: LayoutBuilder(
              builder: (context, constraints) {
                // Cell height follows the text scale so a larger system font
                // grows the card instead of overflowing it.
                final cellWidth = (constraints.maxWidth - AppSpacing.sm) / 2;
                final scale = MediaQuery.textScalerOf(context).scale(1);
                final cellHeight =
                    (cellWidth / 1.08) * (scale > 1 ? scale * 0.94 : 1);

                return GridView.count(
                  crossAxisCount: 2,
                  crossAxisSpacing: AppSpacing.sm,
                  mainAxisSpacing: AppSpacing.sm,
                  childAspectRatio: cellWidth / cellHeight,
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  children: [
                    _EnvCard(
                      title: 'Air temperature',
                      value: '${env.temperature}',
                      unit: '°C',
                      subtitle: env.weatherCondition,
                      icon: Icons.thermostat_rounded,
                      color: AppColors.temperature,
                      bgColor: AppColors.temperatureBg,
                      isWarning: env.temperature > 38.0,
                    ),
                    _EnvCard(
                      title: 'Humidity',
                      value: '${env.humidity}',
                      unit: '%',
                      subtitle: env.humidity > 70 ? 'High' : 'Comfortable',
                      icon: Icons.water_drop_rounded,
                      color: AppColors.humidity,
                      bgColor: const Color(0xFFF0F9FF),
                      isWarning: env.humidity > 75,
                    ),
                    _EnvCard(
                      title: 'Air quality',
                      value: '${env.aqi}',
                      unit: 'AQI',
                      subtitle: env.aqiCategory,
                      icon: Icons.air_rounded,
                      color: AppColors.aqi,
                      bgColor: const Color(0xFFF5F3FF),
                      isWarning: env.aqi > 150,
                    ),
                    _EnvCard(
                      title: 'Feels like',
                      value: '${env.heatIndex}',
                      unit: '°C',
                      subtitle:
                          '${env.heatExposureHours.toStringAsFixed(1)} h in the heat',
                      icon: Icons.local_fire_department_rounded,
                      color: AppColors.heatIndex,
                      bgColor: const Color(0xFFFFF7ED),
                      isWarning: env.heatIndex > 35.0,
                    ),
                  ],
                );
              },
            ),
          ),

          // ── Advice ───────────────────────────────────────────────────────
          FadeSlideIn(
            index: order++,
            child: const SectionHeader(title: 'What to do'),
          ),
          FadeSlideIn(
            index: order++,
            child: AppCard(
              padding: const EdgeInsets.symmetric(horizontal: AppSpacing.md),
              child: Column(
                children: [
                  InfoRow(
                    icon: Icons.wb_sunny_outlined,
                    title: 'Heat',
                    subtitle: env.heatIndex > 38.0
                        ? 'It feels dangerously hot. Get into shade, stop hard '
                            'work and drink water now.'
                        : 'The heat is within a range your body can handle. '
                            'Keep drinking water.',
                    iconColor: env.heatIndex > 38.0
                        ? AppColors.riskHigh
                        : AppColors.riskSafe,
                  ),
                  const Divider(height: 1),
                  InfoRow(
                    icon: Icons.masks_outlined,
                    title: 'Air quality',
                    subtitle: env.aqi > 200
                        ? 'Air quality is unhealthy at ${env.aqi} AQI. Stay '
                            'indoors where you can, and wear a mask outside.'
                        : 'Air quality is fine for breathing normally.',
                    iconColor:
                        env.aqi > 200 ? AppColors.riskHigh : AppColors.riskSafe,
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _EnvCard extends StatelessWidget {
  final String title;
  final String value;
  final String unit;
  final String subtitle;
  final IconData icon;
  final Color color;
  final Color bgColor;
  final bool isWarning;

  const _EnvCard({
    required this.title,
    required this.value,
    required this.unit,
    required this.subtitle,
    required this.icon,
    required this.color,
    required this.bgColor,
    this.isWarning = false,
  });

  @override
  Widget build(BuildContext context) {
    return AppCard(
      padding: const EdgeInsets.all(AppSpacing.sm + 2),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Row(
            children: [
              Container(
                padding: const EdgeInsets.all(6),
                decoration: BoxDecoration(
                  color: bgColor,
                  borderRadius: AppRadius.brXs,
                ),
                child: Icon(icon, size: 16, color: color),
              ),
              AppSpacing.hGapXs,
              Expanded(
                child: Text(
                  title,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.bodySmall.copyWith(
                    color: AppColors.textSecondary,
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ),
              if (isWarning)
                Container(
                  width: 7,
                  height: 7,
                  decoration: const BoxDecoration(
                    color: AppColors.riskHigh,
                    shape: BoxShape.circle,
                  ),
                ),
            ],
          ),
          Row(
            crossAxisAlignment: CrossAxisAlignment.baseline,
            textBaseline: TextBaseline.alphabetic,
            children: [
              Flexible(
                child: Text(
                  value,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.metricValue.copyWith(color: color),
                ),
              ),
              const SizedBox(width: 3),
              Text(
                unit,
                style: AppTypography.bodySmall.copyWith(
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ),
          Text(
            subtitle,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: AppTypography.bodySmall.copyWith(
              color: isWarning ? AppColors.riskHigh : AppColors.textTertiary,
              fontWeight: isWarning ? FontWeight.w600 : FontWeight.w400,
            ),
          ),
        ],
      ),
    );
  }
}
