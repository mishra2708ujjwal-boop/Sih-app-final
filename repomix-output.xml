<file path="lib/shared/widgets/prana_line_chart.dart">
import 'dart:math';
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import 'app_card.dart';
import 'status_pill.dart';

class ChartDataPoint {
  final DateTime time;
  final double value;

  const ChartDataPoint({required this.time, required this.value});
}

/// Custom-Painted Biometric Line Chart with Personal Baseline Shading
class PranaLineChart extends StatelessWidget {
  final List<ChartDataPoint> dataPoints;
  final double baselineMin;
  final double baselineMax;
  final String unit;
  final Color lineColor;
  final Color? areaColor;
  final double height;
  final bool showBaselineBand;
  final String title;

  const PranaLineChart({
    super.key,
    required this.dataPoints,
    required this.baselineMin,
    required this.baselineMax,
    this.unit = '',
    this.lineColor = AppColors.primary,
    this.areaColor,
    this.height = 180.0,
    this.showBaselineBand = true,
    this.title = '',
  });

  @override
  Widget build(BuildContext context) {
    if (dataPoints.isEmpty) {
      return AppCard(
        child: SizedBox(
          height: height,
          child: Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(Icons.show_chart_rounded, size: 36, color: AppColors.textTertiary),
                const SizedBox(height: 8),
                Text(
                  title.isNotEmpty ? '$title (Awaiting Data)' : 'No historical telemetry yet',
                  style: AppTypography.titleMedium.copyWith(color: AppColors.textSecondary),
                ),
                const SizedBox(height: 4),
                Text(
                  'Stream biometrics from ESP32 or activate Demo Lab',
                  style: AppTypography.bodySmall,
                ),
              ],
            ),
          ),
        ),
      );
    }

    final latestValue = dataPoints.last.value;
    final isWithinBaseline = latestValue >= baselineMin && latestValue <= baselineMax;

    return AppCard(
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          if (title.isNotEmpty) ...[
            Text(title, style: AppTypography.titleMedium),
            AppSpacing.gapXs,
            // The status pill used to share the title's Row with no Expanded —
            // "Within Baseline (60.0–100.0 BPM)" clipped at 360dp. It wraps
            // below the title now, alongside the band legend.
            Wrap(
              spacing: AppSpacing.xs,
              runSpacing: AppSpacing.xxs,
              crossAxisAlignment: WrapCrossAlignment.center,
              children: [
                StatusPill(
                  label: isWithinBaseline
                      ? 'Within baseline ${baselineMin.toStringAsFixed(0)}–${baselineMax.toStringAsFixed(0)} $unit'
                      : 'Deviation ${latestValue - baselineMax > 0 ? "+${(latestValue - baselineMax).toStringAsFixed(1)}" : (latestValue - baselineMin).toStringAsFixed(1)} $unit',
                  color: isWithinBaseline
                      ? AppColors.riskSafe
                      : AppColors.riskHigh,
                  backgroundColor: isWithinBaseline
                      ? AppColors.riskSafeBg
                      : AppColors.riskHighBg,
                  dense: true,
                ),
                Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Container(
                      width: 10,
                      height: 10,
                      decoration: BoxDecoration(
                        color: AppColors.primaryContainer,
                        borderRadius: BorderRadius.circular(2),
                        border: Border.all(
                          color: AppColors.primaryLight.withValues(alpha: 0.4),
                        ),
                      ),
                    ),
                    AppSpacing.hGapXxs,
                    Text('Your normal range', style: AppTypography.bodySmall),
                  ],
                ),
              ],
            ),
            AppSpacing.gapSm,
          ],
          SizedBox(
            height: height,
            child: CustomPaint(
              size: Size.infinite,
              painter: _ChartPainter(
                dataPoints: dataPoints,
                baselineMin: baselineMin,
                baselineMax: baselineMax,
                lineColor: lineColor,
                areaColor: areaColor ?? lineColor.withValues(alpha: 0.12),
                showBaselineBand: showBaselineBand,
              ),
            ),
          ),
          AppSpacing.gapXs,
          Row(
            children: [
              Text('24h ago', style: AppTypography.bodySmall),
              const Spacer(),
              Flexible(
                child: Text(
                  'Now ${latestValue.toStringAsFixed(1)} $unit',
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: AppTypography.bodySmall.copyWith(
                    fontWeight: FontWeight.w700,
                    color: lineColor,
                  ),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

class _ChartPainter extends CustomPainter {
  final List<ChartDataPoint> dataPoints;
  final double baselineMin;
  final double baselineMax;
  final Color lineColor;
  final Color areaColor;
  final bool showBaselineBand;

  _ChartPainter({
    required this.dataPoints,
    required this.baselineMin,
    required this.baselineMax,
    required this.lineColor,
    required this.areaColor,
    required this.showBaselineBand,
  });

  @override
  void paint(Canvas canvas, Size size) {
    if (dataPoints.length < 2) return;

    double minY = dataPoints.map((e) => e.value).reduce(min);
    double maxY = dataPoints.map((e) => e.value).reduce(max);

    minY = min(minY, baselineMin) * 0.95;
    maxY = max(maxY, baselineMax) * 1.05;
    if (maxY == minY) maxY += 1.0;

    double getYPos(double val) {
      final normalized = (val - minY) / (maxY - minY);
      return size.height - (normalized * size.height);
    }

    double getXPos(int index) {
      return (index / (dataPoints.length - 1)) * size.width;
    }

    // 1. Draw subtle background grid lines
    final gridPaint = Paint()
      ..color = AppColors.borderLight
      ..strokeWidth = 1.0;

    for (int i = 1; i <= 3; i++) {
      final y = size.height * (i / 4);
      canvas.drawLine(Offset(0, y), Offset(size.width, y), gridPaint);
    }

    // 2. Draw Personal Baseline Shaded Band
    if (showBaselineBand) {
      final baselineTopY = getYPos(baselineMax);
      final baselineBottomY = getYPos(baselineMin);

      final baselinePaint = Paint()
        ..color = AppColors.primaryLight.withValues(alpha: 0.09)
        ..style = PaintingStyle.fill;

      canvas.drawRect(
        Rect.fromLTRB(0, baselineTopY, size.width, baselineBottomY),
        baselinePaint,
      );

      // Baseline border lines
      final baselineLinePaint = Paint()
        ..color = AppColors.primaryLight.withValues(alpha: 0.35)
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1.0;

      canvas.drawLine(Offset(0, baselineTopY), Offset(size.width, baselineTopY), baselineLinePaint);
      canvas.drawLine(Offset(0, baselineBottomY), Offset(size.width, baselineBottomY), baselineLinePaint);
    }

    // 3. Construct Smooth Cubic Bezier Line Path
    final path = Path();
    final fillPath = Path();

    final firstPoint = Offset(getXPos(0), getYPos(dataPoints[0].value));
    path.moveTo(firstPoint.dx, firstPoint.dy);
    fillPath.moveTo(firstPoint.dx, size.height);
    fillPath.lineTo(firstPoint.dx, firstPoint.dy);

    for (int i = 0; i < dataPoints.length - 1; i++) {
      final p0 = Offset(getXPos(i), getYPos(dataPoints[i].value));
      final p1 = Offset(getXPos(i + 1), getYPos(dataPoints[i + 1].value));

      final controlPoint1 = Offset(p0.dx + (p1.dx - p0.dx) / 2, p0.dy);
      final controlPoint2 = Offset(p0.dx + (p1.dx - p0.dx) / 2, p1.dy);

      path.cubicTo(
        controlPoint1.dx,
        controlPoint1.dy,
        controlPoint2.dx,
        controlPoint2.dy,
        p1.dx,
        p1.dy,
      );

      fillPath.cubicTo(
        controlPoint1.dx,
        controlPoint1.dy,
        controlPoint2.dx,
        controlPoint2.dy,
        p1.dx,
        p1.dy,
      );
    }

    fillPath.lineTo(getXPos(dataPoints.length - 1), size.height);
    fillPath.close();

    // Draw Gradient Area Fill
    final areaPaint = Paint()
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [
          lineColor.withValues(alpha: 0.22),
          lineColor.withValues(alpha: 0.0),
        ],
      ).createShader(Rect.fromLTWH(0, 0, size.width, size.height))
      ..style = PaintingStyle.fill;

    canvas.drawPath(fillPath, areaPaint);

    // Draw Smooth Line
    final linePaint = Paint()
      ..color = lineColor
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.4
      ..strokeCap = StrokeCap.round
      ..strokeJoin = StrokeJoin.round;

    canvas.drawPath(path, linePaint);

    // 4. Draw Current Endpoint Dot
    final lastIndex = dataPoints.length - 1;
    final lastPoint = Offset(getXPos(lastIndex), getYPos(dataPoints[lastIndex].value));

    final endpointDot = Paint()..color = lineColor;
    final endpointHalo = Paint()..color = lineColor.withValues(alpha: 0.3);
    final endpointCenter = Paint()..color = Colors.white;

    canvas.drawCircle(lastPoint, 6.0, endpointHalo);
    canvas.drawCircle(lastPoint, 4.0, endpointDot);
    canvas.drawCircle(lastPoint, 2.0, endpointCenter);
  }

  @override
  bool shouldRepaint(covariant _ChartPainter oldDelegate) {
    return oldDelegate.dataPoints != dataPoints ||
        oldDelegate.baselineMin != baselineMin ||
        oldDelegate.baselineMax != baselineMax ||
        oldDelegate.lineColor != lineColor;
  }
}
</file>

