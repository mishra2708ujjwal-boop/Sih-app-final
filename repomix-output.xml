import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import '../../core/services/prana_health_controller.dart';
import '../../shared/widgets/prana_line_chart.dart';
import '../../shared/widgets/section_header.dart';
import '../../shared/widgets/app_card.dart';
import '../../shared/widgets/app_segmented_control.dart';
import '../../shared/widgets/empty_state.dart';
import '../../shared/widgets/fade_slide_in.dart';
import '../../shared/widgets/prana_scaffold.dart';
import '../../shared/widgets/status_pill.dart';
import '../../shared/widgets/info_row.dart';
import '../../shared/models/risk_result.dart';
import '../environment/environment_screen.dart';

/// Insights — Analysis | Environment.
class InsightsScreen extends StatefulWidget {
  final int initialSegment;

  const InsightsScreen({super.key, this.initialSegment = 0});

  @override
  State<InsightsScreen> createState() => _InsightsScreenState();
}

class _InsightsScreenState extends State<InsightsScreen> {
  late int _segment = widget.initialSegment;

  @override
  void didUpdateWidget(InsightsScreen oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.initialSegment != oldWidget.initialSegment) {
      setState(() => _segment = widget.initialSegment);
    }
  }

  @override
  Widget build(BuildContext context) {
    return PranaScaffold(
      title: 'Insights',
      subtitle: 'Worked out on your phone, from your own readings',
      headerBottom: AppSegmentedControl(
        segments: const ['Analysis', 'Environment'],
        icons: const [Icons.auto_awesome_rounded, Icons.cloud_outlined],
        selectedIndex: _segment,
        onChanged: (i) => setState(() => _segment = i),
      ),
      body: IndexedStack(
        index: _segment,
        children: const [_AnalysisView(), EnvironmentView()],
      ),
    );
  }
}

class _AnalysisView extends StatelessWidget {
  const _AnalysisView();

  @override
  Widget build(BuildContext context) {
    final controller = context.watch<PranaHealthController>();
    final risk = controller.currentRisk;
    final health = controller.currentHealth;
    final env = controller.currentEnvironment;
    final baseline = controller.currentBaseline;
    final hasData = controller.hasLiveData;

    const padding = EdgeInsets.fromLTRB(
      AppSpacing.md,
      AppSpacing.xxs,
      AppSpacing.md,
      AppSpacing.navClearance,
    );

    // No live stream means every number below would be a zero dressed up as a
    // finding. Say so instead.
    if (!hasData) {
      return SingleChildScrollView(
        padding: padding,
        child: AppCard(
          child: EmptyState(
            icon: Icons.insights_rounded,
            title: 'Nothing to analyse yet',
            subtitle:
                'PRANA needs live readings from your sensor before it can '
                'explain what your body is doing.',
            actionLabel: 'Connect device',
            onAction: () => controller.startBleScan(),
          ),
        ),
      );
    }

    final hrDev = controller.baselineService.getHrDeviationPercent(
      health.heartRate,
    );
    final hot = env.heatIndex > 35.0;
    var order = 0;

    return SingleChildScrollView(
      padding: padding,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // ── What the model picked up ─────────────────────────────────────
          FadeSlideIn(
            index: order++,
            child: AppCard(
              padding: const EdgeInsets.symmetric(horizontal: AppSpacing.md),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Padding(
                    padding: const EdgeInsets.only(
                      top: AppSpacing.sm,
                      bottom: AppSpacing.xs,
                    ),
                    child: Text(
                      'What PRANA noticed',
                      style: AppTypography.labelMedium.copyWith(
                        color: AppColors.primary,
                        fontWeight: FontWeight.w700,
                      ),
                    ),
                  ),
                  const Divider(height: 1),
                  InfoRow(
                    icon: Icons.favorite_rounded,
                    title: 'Your heart rate',
                    subtitle: hrDev > 5.0
