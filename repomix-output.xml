<file path="lib/shared/widgets/risk_score_gauge.dart">
import 'dart:math';
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../models/risk_result.dart';
import 'status_pill.dart';

/// Animated radial arc gauge showcasing the primary Risk Score (0-100)
class RiskScoreGauge extends StatefulWidget {
  final int score;
  final RiskLevel level;
  final String trend;
  final double size;

  const RiskScoreGauge({
    super.key,
    required this.score,
    required this.level,
    required this.trend,
    this.size = 200.0,
  });

  @override
  State<RiskScoreGauge> createState() => _RiskScoreGaugeState();
}

class _RiskScoreGaugeState extends State<RiskScoreGauge>
    with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _animation;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1000),
    );
    _animation = Tween<double>(begin: 0.0, end: widget.score / 100.0).animate(
      CurvedAnimation(parent: _controller, curve: Curves.easeOutCubic),
    );
    _controller.forward();
  }

  @override
  void didUpdateWidget(covariant RiskScoreGauge oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.score != widget.score) {
      _animation = Tween<double>(
        begin: oldWidget.score / 100.0,
        end: widget.score / 100.0,
      ).animate(
        CurvedAnimation(parent: _controller, curve: Curves.easeOutCubic),
      );
      _controller.forward(from: 0.0);
    }
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  IconData _getTrendIcon(String trend) {
    if (trend.toLowerCase().contains('increas') || trend.toLowerCase().contains('spik')) {
      return Icons.arrow_upward_rounded;
    } else if (trend.toLowerCase().contains('decreas') || trend.toLowerCase().contains('improv')) {
      return Icons.arrow_downward_rounded;
    }
    return Icons.arrow_forward_rounded;
  }

  Color _getTrendColor(String trend) {
    if (trend.toLowerCase().contains('increas') || trend.toLowerCase().contains('spik')) {
      return widget.level == RiskLevel.safe ? AppColors.textSecondary : AppColors.riskHigh;
    } else if (trend.toLowerCase().contains('decreas') || trend.toLowerCase().contains('improv')) {
      return AppColors.riskSafe;
    }
    return AppColors.textSecondary;
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _animation,
      builder: (context, child) {
        final animatedScore = (_animation.value * 100).round();
        return SizedBox(
          width: widget.size,
          height: widget.size,
          child: Stack(
            alignment: Alignment.center,
            children: [
              CustomPaint(
                size: Size(widget.size, widget.size),
                painter: _GaugePainter(
                  progress: _animation.value,
                  activeColor: widget.level.color,
                ),
              ),
              Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text(
                    'CURRENT RISK',
                    style: AppTypography.labelCaps.copyWith(
                      color: AppColors.textTertiary,
                      letterSpacing: 1.4,
                    ),
                  ),
                  Text(
                    '$animatedScore',
                    style: AppTypography.displayLarge.copyWith(
                      color: AppColors.textPrimary,
                      fontWeight: FontWeight.w800,
                      height: 1.05,
                    ),
                  ),
                  const SizedBox(height: 4),
                  StatusPill(
                    label: widget.level.displayName,
                    color: widget.level.color,
                    backgroundColor: widget.level.bgColor,
                    caps: true,
                    dense: true,
                  ),
                  const SizedBox(height: 5),
                  ConstrainedBox(
                    constraints: BoxConstraints(maxWidth: widget.size * 0.62),
                    child: Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Icon(
                          _getTrendIcon(widget.trend),
                          size: 13,
                          color: _getTrendColor(widget.trend),
                        ),
                        const SizedBox(width: 3),
                        Flexible(
                          child: Text(
                            widget.trend,
                            maxLines: 1,
                            overflow: TextOverflow.ellipsis,
                            style: AppTypography.bodySmall.copyWith(
                              color: _getTrendColor(widget.trend),
                              fontWeight: FontWeight.w600,
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ],
          ),
        );
      },
    );
  }
}

class _GaugePainter extends CustomPainter {
  final double progress;
  final Color activeColor;

  _GaugePainter({required this.progress, required this.activeColor});

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    final radius = min(size.width, size.height) / 2 - 13;
    const startAngle = 135 * (pi / 180);
    const sweepAngle = 270 * (pi / 180);
    const strokeWidth = 13.0;

    final rect = Rect.fromCircle(center: center, radius: radius);

    // Background track
    final trackPaint = Paint()
      ..color = AppColors.borderLight
      ..style = PaintingStyle.stroke
      ..strokeWidth = strokeWidth
      ..strokeCap = StrokeCap.round;

    canvas.drawArc(rect, startAngle, sweepAngle, false, trackPaint);

    // Active progress arc — swept gradient from a lighter tint into the full
    // level colour, so the arc reads as a scale rather than a flat bar.
    final activeSweep = sweepAngle * progress.clamp(0.0, 1.0);
    if (activeSweep > 0.001) {
      final activePaint = Paint()
        ..shader = SweepGradient(
          startAngle: startAngle,
          endAngle: startAngle + sweepAngle,
          colors: [
            Color.lerp(activeColor, Colors.white, 0.45)!,
            activeColor,
          ],
          transform: GradientRotation(startAngle),
        ).createShader(rect)
        ..style = PaintingStyle.stroke
        ..strokeWidth = strokeWidth
        ..strokeCap = StrokeCap.round;

      canvas.drawArc(rect, startAngle, activeSweep, false, activePaint);

      // Indicator thumb dot
      final currentAngle = startAngle + activeSweep;
      final thumbCenter = Offset(
        center.dx + radius * cos(currentAngle),
        center.dy + radius * sin(currentAngle),
      );

      canvas.drawCircle(
        thumbCenter,
        11,
        Paint()..color = activeColor.withValues(alpha: 0.18),
      );
      canvas.drawCircle(thumbCenter, 7, Paint()..color = Colors.white);
      canvas.drawCircle(
        thumbCenter,
        7,
        Paint()
          ..color = activeColor
          ..style = PaintingStyle.stroke
          ..strokeWidth = 3.0,
      );
    }
  }

  @override
  bool shouldRepaint(covariant _GaugePainter oldDelegate) {
    return oldDelegate.progress != progress || oldDelegate.activeColor != activeColor;
  }
}
</file>

<file path="lib/shared/widgets/scenario_banner.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';
import '../../features/scenarios/disaster_scenario_engine.dart';

/// Slim single-line scenario chip.
///
/// This is the only scenario control left in the main flow — the full preset
/// list with descriptions lives in Profile › Demo Lab. Kept on Home so a judge
/// can switch conditions mid-demo without leaving the dashboard.
class ScenarioBanner extends StatelessWidget {
  final DisasterScenario currentScenario;
  final ValueChanged<DisasterScenario> onScenarioChanged;

  const ScenarioBanner({
    super.key,
    required this.currentScenario,
    required this.onScenarioChanged,
  });

  @override
  Widget build(BuildContext context) {
    final isNormal = currentScenario == DisasterScenario.normal;
    final accent = isNormal ? AppColors.textSecondary : currentScenario.badgeColor;

    return PopupMenuButton<DisasterScenario>(
      initialValue: currentScenario,
      onSelected: onScenarioChanged,
      tooltip: 'Switch demo scenario',
      position: PopupMenuPosition.under,
      shape: RoundedRectangleBorder(borderRadius: AppRadius.brMd),
      itemBuilder: (context) => DisasterScenario.values.map((scenario) {
        return PopupMenuItem<DisasterScenario>(
