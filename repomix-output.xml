import '../../shared/widgets/fade_slide_in.dart';
import '../../shared/widgets/prana_scaffold.dart';
import 'emergency_service.dart';

/// Emergency screen — reached from the centre SOS button, which navigates here
/// rather than dispatching, so a mis-tap costs nothing.
class EmergencyScreen extends StatelessWidget {
  const EmergencyScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final controller = context.watch<PranaHealthController>();
    final emergency = controller.emergencyService;
    final state = emergency.currentState;
    final profile = controller.userProfile;
    final contacts = profile.emergencyContacts;
    // May legitimately be empty — a fresh install has nobody saved yet.
    final EmergencyContact? primaryContact = contacts.isEmpty
        ? null
        : contacts.firstWhere((c) => c.isPrimary, orElse: () => contacts.first);

    final isAlarming =
        state == EmergencyState.countdown || state == EmergencyState.sosSent;

    // Calm, light shell while nothing is happening; the alarm states take over
    // the whole screen in dark red so they can't be mistaken for anything else.
    if (!isAlarming) {
      return PranaScaffold(
        title: 'Emergency',
        subtitle: 'Fall detection and SOS',
        tint: AppColors.riskCritical,
        body: SingleChildScrollView(
          padding: const EdgeInsets.fromLTRB(
            AppSpacing.xl,
            AppSpacing.xxs,
            AppSpacing.xl,
            AppSpacing.xl,
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: _idle(emergency, primaryContact),
          ),
        ),
      );
    }

    return Scaffold(
      backgroundColor: const Color(0xFF1A1013),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        iconTheme: const IconThemeData(color: Colors.white),
        title: const Text('Emergency', style: TextStyle(color: Colors.white)),
        systemOverlayStyle: const SystemUiOverlayStyle(
          statusBarColor: Colors.transparent,
          statusBarIconBrightness: Brightness.light,
        ),
      ),
      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.symmetric(
            horizontal: AppSpacing.xl,
            vertical: AppSpacing.md,
          ),
          child: ConstrainedBox(
            constraints: BoxConstraints(
              minHeight: MediaQuery.of(context).size.height * 0.62,
            ),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: state == EmergencyState.countdown
                  ? _countdown(emergency)
                  : _sent(emergency, profile, primaryContact),
            ),
          ),
        ),
      ),
    );
  }

  // ── Countdown ──────────────────────────────────────────────────────────────
  List<Widget> _countdown(EmergencyService emergency) => [
        Center(
          child: StreamBuilder<int>(
            stream: emergency.countdownStream,
            initialData: emergency.countdownRemaining,
            builder: (context, snapshot) {
              final remaining = snapshot.data ?? 10;
              final total = 10;
              final progress = remaining / total;
              return _CountdownRing(progress: progress, remaining: remaining);
            },
          ),
        ),
        AppSpacing.gapLg,
        Text(
          'Possible fall detected',
          textAlign: TextAlign.center,
          style: AppTypography.headlineMedium.copyWith(
            color: Colors.white,
            fontWeight: FontWeight.w800,
            letterSpacing: 0.2,
          ),
        ),
        AppSpacing.gapXs,
        Text(
          'Your band has not moved since the impact.\n'
          'PRANA will send an SOS when the countdown reaches zero.',
          textAlign: TextAlign.center,
          style: AppTypography.bodyMedium.copyWith(
            color: const Color(0xFFCBD5E1),
          ),
        ),
        AppSpacing.gapXl,
        SizedBox(
          height: 54,
          child: ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.riskCritical,
              foregroundColor: Colors.white,
            ),
            onPressed: emergency.triggerManualSos,
            child: const Text(
              'Send SOS now',
              style: TextStyle(fontWeight: FontWeight.w800),
            ),
          ),
        ),
        AppSpacing.gapMd,
        SizedBox(
          height: 54,
          child: OutlinedButton(
            style: OutlinedButton.styleFrom(
              side: const BorderSide(color: Colors.white54, width: 1.6),
              foregroundColor: Colors.white,
            ),
            onPressed: emergency.cancelEmergency,
            child: const Text(
              "I'm OK — cancel",
              style: TextStyle(fontWeight: FontWeight.w700),
            ),
          ),
        ),
      ];

  // ── SOS sent ───────────────────────────────────────────────────────────────
  List<Widget> _sent(
    EmergencyService emergency,
    UserProfile profile,
    EmergencyContact? contact,
  ) =>
      [
        Center(
          child: Container(
            width: 88,
            height: 88,
            decoration: BoxDecoration(
              color: AppColors.riskCritical.withValues(alpha: 0.18),
              shape: BoxShape.circle,
              border: Border.all(
                color: AppColors.riskCritical.withValues(alpha: 0.45),
                width: 2,
              ),
            ),
            child: const Icon(
              Icons.check_circle_outline_rounded,
              size: 48,
              color: AppColors.riskCritical,
            ),
          ),
        ),
        AppSpacing.gapLg,
        Text(
          'Emergency alert sent',
          textAlign: TextAlign.center,
          style: AppTypography.headlineMedium.copyWith(
            color: Colors.white,
            fontWeight: FontWeight.w800,
          ),
        ),
        AppSpacing.gapMd,
        Container(
          padding: const EdgeInsets.all(AppSpacing.md),
          decoration: BoxDecoration(
            color: const Color(0xFF2A1A1E),
            borderRadius: AppRadius.brLg,
            border: Border.all(
              color: AppColors.riskCritical.withValues(alpha: 0.35),
            ),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              _SosDetail(
                icon: Icons.person_pin_rounded,
                label: 'Sent to',
                value: contact == null
                    ? 'No emergency contact saved'
                    : '${contact.name} · ${contact.phone}',
              ),
              const Divider(color: Color(0xFF463034), height: AppSpacing.lg),
              _SosDetail(
                icon: Icons.location_on_rounded,
                label: 'Location',
                value: emergency.dispatchedGpsLocation ?? 'Coordinates attached',
              ),
              const Divider(color: Color(0xFF463034), height: AppSpacing.lg),
              _SosDetail(
                icon: Icons.medical_information_rounded,
                label: 'Medical notes',
                value: profile.medicalConditions.isEmpty
                    ? 'None on record'
                    : profile.medicalConditions.join(', '),
              ),
            ],
          ),
        ),
        AppSpacing.gapXl,
        SizedBox(
          height: 52,
          child: OutlinedButton(
            style: OutlinedButton.styleFrom(
              side: const BorderSide(color: Colors.white38, width: 1.6),
              foregroundColor: Colors.white,
            ),
            onPressed: emergency.resolveEmergency,
            child: const Text('Mark as resolved'),
          ),
        ),
      ];

  // ── Idle ───────────────────────────────────────────────────────────────────
  List<Widget> _idle(EmergencyService emergency, EmergencyContact? contact) {
    var order = 0;
    return [
      FadeSlideIn(
        index: order++,
        child: Center(
          child: Container(
            width: 88,
            height: 88,
            decoration: BoxDecoration(
              color: AppColors.riskCriticalBg,
              shape: BoxShape.circle,
              border: Border.all(
                color: AppColors.riskCritical.withValues(alpha: 0.25),
                width: 2,
              ),
            ),
            child: const Icon(
              Icons.emergency_rounded,
              size: 44,
              color: AppColors.riskCritical,
            ),
          ),
        ),
      ),
      AppSpacing.gapLg,
      FadeSlideIn(
        index: order++,
        child: Text(
          'Emergency help is ready',
          textAlign: TextAlign.center,
          style: AppTypography.headlineMedium,
        ),
      ),
      AppSpacing.gapXs,
      FadeSlideIn(
        index: order++,
        child: Text(
          'PRANA watches for falls in the background. You can also send an SOS '
          'yourself at any time.',
          textAlign: TextAlign.center,
          style: AppTypography.bodyMedium,
        ),
      ),
      AppSpacing.gapLg,
      FadeSlideIn(
        index: order++,
        child: AppCard(
          child: Row(
            children: [
              Container(
                width: 42,
                height: 42,
                decoration: BoxDecoration(
                  color: contact == null
                      ? AppColors.surfaceSubtle
                      : AppColors.riskCriticalBg,
                  shape: BoxShape.circle,
                ),
                child: Icon(
                  contact == null
                      ? Icons.person_add_alt_1_rounded
                      : Icons.star_rounded,
                  size: 20,
                  color: contact == null
                      ? AppColors.textTertiary
                      : AppColors.riskCritical,
                ),
              ),
              AppSpacing.hGapSm,
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      'Primary contact',
                      style: AppTypography.labelMedium.copyWith(
                        color: AppColors.textTertiary,
                      ),
                    ),
                    const SizedBox(height: 2),
                    Text(
                      contact == null
                          ? 'Add one in your profile'
                          : '${contact.name} · ${contact.phone}',
                      maxLines: 1,
                      overflow: TextOverflow.ellipsis,
                      style: AppTypography.titleMedium.copyWith(
                        color: contact == null
                            ? AppColors.textSecondary
                            : AppColors.textPrimary,
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
      AppSpacing.gapSm,
      FadeSlideIn(
        index: order++,
        child: AppCard(
          color: AppColors.surfaceSubtle,
          padding: const EdgeInsets.all(AppSpacing.sm + 2),
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Icon(
                Icons.info_outline_rounded,
                size: 16,
                color: AppColors.textTertiary,
              ),
              AppSpacing.hGapXs,
              Expanded(
                child: Text(
                  'Sending an SOS starts a 10-second countdown. You can cancel '
                  'any time before it goes out.',
                  style: AppTypography.bodySmall.copyWith(
                    color: AppColors.textSecondary,
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
      AppSpacing.gapLg,
      FadeSlideIn(
        index: order++,
        child: SizedBox(
          height: 56,
          child: ElevatedButton.icon(
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.riskCritical,
              foregroundColor: Colors.white,
            ),
            icon: const Icon(Icons.sos_rounded, size: 22),
            label: const Text(
              'Send SOS',
              style: TextStyle(fontWeight: FontWeight.w800),
            ),
            onPressed: emergency.triggerManualSos,
          ),
        ),
      ),
    ];
  }
}

// ── Countdown ring ────────────────────────────────────────────────────────────
/// A circular progress arc that surrounds the countdown icon, giving
/// users a spatial + temporal reference for the remaining time.
class _CountdownRing extends StatelessWidget {
  final double progress; // 0.0 (done) → 1.0 (full)
  final int remaining;

  const _CountdownRing({required this.progress, required this.remaining});

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 120,
      height: 120,
      child: Stack(
        alignment: Alignment.center,
        children: [
          CustomPaint(
            size: const Size(120, 120),
            painter: _ArcPainter(progress: progress),
          ),
          Container(
            width: 84,
            height: 84,
            decoration: BoxDecoration(
              color: AppColors.riskCritical.withValues(alpha: 0.14),
              shape: BoxShape.circle,
              border: Border.all(color: AppColors.riskCritical, width: 2),
            ),
            child: Center(
              child: Text(
                '$remaining',
                style: AppTypography.displayLarge.copyWith(
                  fontSize: 40,
                  height: 1.05,
                  color: AppColors.riskCritical,
                  fontWeight: FontWeight.w900,
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _ArcPainter extends CustomPainter {
  final double progress;
  _ArcPainter({required this.progress});

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    final radius = size.width / 2 - 4;
    const startAngle = -pi / 2;
    const fullSweep = 2 * pi;

    // Track
    canvas.drawArc(
      Rect.fromCircle(center: center, radius: radius),
      startAngle,
      fullSweep,
      false,
      Paint()
        ..color = AppColors.riskCritical.withValues(alpha: 0.15)
        ..style = PaintingStyle.stroke
        ..strokeWidth = 5
        ..strokeCap = StrokeCap.round,
    );

    // Active progress arc — sweeps clockwise.
    final sweep = fullSweep * progress.clamp(0.0, 1.0);
    if (sweep > 0.001) {
      canvas.drawArc(
        Rect.fromCircle(center: center, radius: radius),
        startAngle,
        sweep,
        false,
        Paint()
          ..color = AppColors.riskCritical
          ..style = PaintingStyle.stroke
          ..strokeWidth = 5
          ..strokeCap = StrokeCap.round,
      );
    }
  }

  @override
  bool shouldRepaint(covariant _ArcPainter old) => old.progress != progress;
}

// ── SOS detail row ────────────────────────────────────────────────────────────
class _SosDetail extends StatelessWidget {
  final IconData icon;
  final String label;
  final String value;

  const _SosDetail({
    required this.icon,
    required this.label,
    required this.value,
  });

  @override
  Widget build(BuildContext context) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Icon(icon, size: 18, color: const Color(0xFFFCA5A5)),
        AppSpacing.hGapSm,
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: AppTypography.labelMedium.copyWith(
                  color: const Color(0xFFCBD5E1),
                ),
              ),
              const SizedBox(height: 2),
              Text(
                value,
                style: AppTypography.bodyMedium.copyWith(
                  color: Colors.white,
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }
}
