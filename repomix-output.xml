<file path="lib/shared/widgets/stat_tile.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';

/// Small label + value tile used inside grids and stat strips.
///
/// Replaces `_statBox`, `_deviceStat`, `_envStatItem` and `_stageBox`. Text
/// wraps to two lines and ellipsises rather than overflowing, which is what
/// broke the old 4-across environment strip on a 360dp screen.
class StatTile extends StatelessWidget {
  final String label;
  final String value;
  final String? unit;
  final IconData? icon;
  final Color? valueColor;
  final Color? accent;

  /// Render on a filled tinted surface rather than transparent.
  final bool filled;

  final CrossAxisAlignment alignment;

  const StatTile({
    super.key,
    required this.label,
    required this.value,
    this.unit,
    this.icon,
    this.valueColor,
    this.accent,
    this.filled = false,
    this.alignment = CrossAxisAlignment.start,
  });

  @override
  Widget build(BuildContext context) {
    final resolvedAccent = accent ?? AppColors.primary;

    final body = Column(
      crossAxisAlignment: alignment,
      mainAxisSize: MainAxisSize.min,
      children: [
        if (icon != null) ...[
          Icon(icon, size: 18, color: resolvedAccent),
          AppSpacing.gapXs,
        ],
        // Baseline-aligned so the unit sits on the value's baseline, not centred.
        Row(
          mainAxisAlignment: alignment == CrossAxisAlignment.center
              ? MainAxisAlignment.center
              : MainAxisAlignment.start,
          crossAxisAlignment: CrossAxisAlignment.baseline,
          textBaseline: TextBaseline.alphabetic,
          children: [
            Flexible(
              child: Text(
                value,
                style: AppTypography.headlineSmall.copyWith(
                  color: valueColor ?? AppColors.textPrimary,
                  fontWeight: FontWeight.w700,
                ),
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
              ),
            ),
            if (unit != null) ...[
              const SizedBox(width: 2),
              Text(
                unit!,
                style: AppTypography.bodySmall.copyWith(
                  color: AppColors.textTertiary,
                  fontWeight: FontWeight.w600,
                ),
              ),
            ],
          ],
        ),
        const SizedBox(height: 3),
        Text(
          label,
          style: AppTypography.bodySmall.copyWith(color: AppColors.textSecondary),
          maxLines: 2,
          overflow: TextOverflow.ellipsis,
          textAlign: alignment == CrossAxisAlignment.center
              ? TextAlign.center
              : TextAlign.start,
        ),
      ],
    );

    if (!filled) return body;

    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: AppSpacing.sm,
        vertical: AppSpacing.sm,
      ),
      decoration: BoxDecoration(
        color: resolvedAccent.withValues(alpha: 0.07),
        borderRadius: AppRadius.brMd,
        border: Border.all(color: resolvedAccent.withValues(alpha: 0.16)),
      ),
      child: body,
    );
  }
}
</file>

<file path="lib/shared/widgets/status_pill.dart">
import 'package:flutter/material.dart';
import '../../core/theme/app_typography.dart';
import '../../core/theme/app_spacing.dart';

/// Compact status pill — the one implementation for every badge in the app.
///
/// Replaces the ~15 inline pill `Container`s that duplicated the same
/// padding/radius/background maths (delta chips, ACTIVE/OFFLINE badges, risk
/// level labels, baseline deviation flags).
class StatusPill extends StatelessWidget {
  final String label;
  final Color color;

  /// Background. Defaults to a 12% tint of [color].
  final Color? backgroundColor;

  final IconData? icon;

  /// Renders a small filled dot instead of an icon — for connectivity states.
  final bool showDot;

  /// Uppercase + wide tracking. Use for state badges, not for numbers.
  final bool caps;

  final bool dense;

  const StatusPill({
    super.key,
    required this.label,
    required this.color,
    this.backgroundColor,
    this.icon,
    this.showDot = false,
    this.caps = false,
    this.dense = false,
  });

  @override
  Widget build(BuildContext context) {
    final textStyle = (caps ? AppTypography.labelCaps : AppTypography.labelMedium)
        .copyWith(color: color, fontWeight: FontWeight.w700);

    return Container(
      padding: EdgeInsets.symmetric(
        horizontal: dense ? AppSpacing.xs : AppSpacing.sm,
        vertical: dense ? 3 : 5,
      ),
      decoration: BoxDecoration(
        color: backgroundColor ?? color.withValues(alpha: 0.12),
        borderRadius: AppRadius.brPill,
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          if (showDot) ...[
            Container(
              width: 7,
              height: 7,
              decoration: BoxDecoration(color: color, shape: BoxShape.circle),
            ),
            AppSpacing.hGapXxs,
          ] else if (icon != null) ...[
            Icon(icon, size: dense ? 12 : 14, color: color),
            AppSpacing.hGapXxs,
          ],
          // Flexible so a long label ellipsises instead of overflowing its row.
          Flexible(
            child: Text(
              caps ? label.toUpperCase() : label,
              style: textStyle,
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
          ),
        ],
      ),
    );
  }
}
</file>

